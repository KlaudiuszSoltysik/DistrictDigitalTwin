<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="flex flex-col justify-center items-center w-full h-full min-h-[600px]">

                <div class="relative w-16 h-16 flex justify-center items-center mb-2">
                    <div class="absolute inset-0 border-4 border-gray-800 rounded-full"></div>
                    <div class="absolute w-8 h-1 bg-gray-700 rotate-45 rounded-sm"></div>
                    <div class="absolute w-8 h-1 bg-gray-700 -rotate-45 rounded-sm"></div>
                </div>

                <p class="mt-4 text-gray-300 font-mono text-sm uppercase tracking-[0.2em]">
                    Error_404
                </p>

                <p class="mt-2 text-gray-400 font-mono text-xs uppercase tracking-[0.15em]">
                    Address not found in the system
                </p>

                <a href="/"
                   class="mt-8 px-6 py-2 border border-gray-700 rounded-md text-gray-400 font-mono text-xs uppercase tracking-widest hover:bg-gray-700 hover:text-white transition-all">
                    Return to system
                </a>

            </div>
        </LayoutView>
    </NotFound>
</Router>
