@page "/tenant-panel"
@using shared
@using website.Components
@layout TenantLayout
@inject HttpClient HttpClient

<div class="my-10 border border-gray-700 rounded-xl overflow-hidden select-none text-white">
    <div class="bg-gray-800 px-6 py-4 border-b border-gray-700 flex items-center justify-between">
        <p class="text-xl font-bold">Thermostat Schedule</p>
        <button @onclick="ApplySchedule" disabled="@_isApplying"
                class="bg-blue-600 hover:bg-blue-500 disabled:bg-gray-600 disabled:text-gray-400 disabled:cursor-not-allowed text-white font-semibold py-2 px-6 rounded-lg shadow-md transition-colors duration-200">
            @if (_isApplying)
            {
                <span>Saving...</span>
            }
            else
            {
                <span>Apply Schedule</span>
            }
        </button>
    </div>

    <div class="p-4 bg-gray-800">
        @if (_isLoading)
        {
            <p class="text-gray-400">Loading rooms...</p>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="text-red-500">@_errorMessage</p>
        }
        else if (!string.IsNullOrEmpty(_saveMessage))
        {
            <p class="text-green-400 mb-4 font-semibold">@_saveMessage</p>
        }

        @foreach (var room in _apartmentConfig.Rooms)
        {
            <div class="mb-6 last:mb-0">
                <HvacScheduler
                    Name="@room.Name"
                    @bind-Temperatures="room.HvacControl.Temperatures"
                    @bind-Tolerance="room.HvacControl.Tolerance"
                    @bind-Co2="room.HvacControl.Co2"
                    @bind-IsEnabled="room.HvacControl.IsEnabled"/>
            </div>
        }
    </div>
</div>

@code {

    [SupplyParameterFromQuery(Name = "building")]
    public required string Building { get; set; }

    [SupplyParameterFromQuery(Name = "apartment")]
    public required string Apartment { get; set; }

    private ApartmentConfig? _apartmentConfig;

    private bool _isLoading = true;
    private bool _isApplying;
    private string? _errorMessage;
    private string? _saveMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var url = $"apartment/get-apartment-config?building={Building}&apartment={Apartment}";
            _apartmentConfig = await HttpClient.GetFromJsonAsync<ApartmentConfig>(url);

            if (_apartmentConfig != null)
            {
                foreach (var hvac in _apartmentConfig.Rooms.Select(room => room.HvacControl))
                {
                    if (hvac.Temperatures is not { Count: 24 })
                    {
                        hvac.Temperatures = Enumerable.Repeat(21.0, 24).ToList();
                    }

                    if (hvac.IsEnabled is not { Count: 24 })
                    {
                        hvac.IsEnabled = Enumerable.Repeat(false, 24).ToList();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplySchedule()
    {
        if (_apartmentConfig == null) return;

        _isApplying = true;
        _errorMessage = null;
        _saveMessage = null;

        try
        {
            var response = await HttpClient.PostAsJsonAsync("apartment/update-apartment-config", _apartmentConfig);

            if (response.IsSuccessStatusCode)
            {
                _saveMessage = "Schedule applied successfully!";
                ClearMessageAfterDelay(3000);
            }
            else
            {
                _errorMessage = "Failed to apply schedule.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Network error while saving.";
        }
        finally
        {
            _isApplying = false;
        }
    }

    private void ClearMessageAfterDelay(int milliseconds)
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(milliseconds);
            _saveMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

}