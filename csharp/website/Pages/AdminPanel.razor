@page "/"

@inject IConfiguration Config
@inject SimulationUiService SimulationService
@using shared
@using website.Components
@implements IAsyncDisposable

<PageTitle>District Digital Twin - Admin Panel</PageTitle>

<SimulationControls
    IsConnected="@IsConnected"
    ConnectionStatus="@_connectionStatus"
    Config="@SimulationService.CurrentStatus?.Config"
    OnResume="Resume"
    OnPause="Pause"
    OnReset="Reset"
    OnSpeedChange="UpdateSpeed"
    OnStepChange="UpdateStep"
/>

<ApexChart TItem="SimulationTelemetry" Title="Temperature [°C]" Options="_temperatureChartOptions" @ref="_chart1">
    <ApexPointSeries TItem="SimulationTelemetry"
                     SeriesType="SeriesType.Line"
                     Name="Temperature"
                     Items="_telemetryHistory"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.Temperature)"/>
</ApexChart>

<ApexChart TItem="SimulationTelemetry" Title="Wind speed [km/h]" Options="_windSpeedChartOptions" @ref="_chart2">
    <ApexPointSeries TItem="SimulationTelemetry"
                     SeriesType="SeriesType.Line"
                     Name="Wind speed"
                     Items="_telemetryHistory"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.WindSpeed)"/>
</ApexChart>

<ApexChart TItem="SimulationTelemetry" Title="Sun radiation [W/m²]" Options="_sunRadiationChartOptions" @ref="_chart3">
    <ApexPointSeries TItem="SimulationTelemetry"
                     SeriesType="SeriesType.Line"
                     Name="Sun radiation"
                     Items="_telemetryHistory"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.SunRadiation)"/>
</ApexChart>

<ApexChart TItem="SimulationTelemetry" Title="Sun altitude [°]" Options="_sunAltitudeChartOptions" @ref="_chart4">
    <ApexPointSeries TItem="SimulationTelemetry"
                     SeriesType="SeriesType.Line"
                     Name="Temperature"
                     Items="_telemetryHistory"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.SunAltitude)"/>
</ApexChart>

@if (_telemetryData != null && _telemetryHistory.Count != 0)
{
    <div style="display: flex; gap: 20px;">

        <div style="flex: 1; border: 1px solid #ccc; padding: 10px;">
            <p>Last telemetry frame</p>
            @if (_telemetryData != null)
            {
                <div style="height: 400px; overflow-y: scroll;">
                    <pre>@JsonSerializer.Serialize(_telemetryData, new JsonSerializerOptions { WriteIndented = true })</pre>
                </div>
            }
        </div>

        <div style="flex: 1; border: 1px solid #ccc; padding: 10px;">
            <p>History</p>
            <div style="height: 400px; overflow-y: scroll;">
                <table class="table table-sm">
                    <thead>
                    <tr>
                        <th>Timestamp</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Enumerable.Reverse(_telemetryHistory))
                    {
                        <tr>
                            <td>@item.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private HubConnection? _hubConnection;
    private SimulationTelemetry? _telemetryData;
    private List<SimulationTelemetry> _telemetryHistory = [];
    private string _connectionStatus = "Disconnected";

    private ApexChart<SimulationTelemetry> _chart1 = new();
    private ApexChart<SimulationTelemetry> _chart2 = new();
    private ApexChart<SimulationTelemetry> _chart3 = new();
    private ApexChart<SimulationTelemetry> _chart4 = new();
    private ApexChartOptions<SimulationTelemetry>? _temperatureChartOptions;
    private ApexChartOptions<SimulationTelemetry>? _windSpeedChartOptions;
    private ApexChartOptions<SimulationTelemetry>? _sunRadiationChartOptions;
    private ApexChartOptions<SimulationTelemetry>? _sunAltitudeChartOptions;

    protected override async Task OnInitializedAsync()
    {
        _temperatureChartOptions = GenerateOptions("°C");
        _windSpeedChartOptions = GenerateOptions(" km/h");
        _sunRadiationChartOptions = GenerateOptions(" W/m²");
        _sunAltitudeChartOptions = GenerateOptions("°");

        var baseApiUrl = Config["BaseApiUrl"];

        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{baseApiUrl}/hubs/simulation")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<SimulationTelemetry>("ReceiveSimulationData", async data =>
        {
            _telemetryData = data;
            _telemetryHistory.Add(data);

            if (_telemetryHistory.Count > 2000) _telemetryHistory.RemoveAt(0);

            await InvokeAsync(StateHasChanged);

            await _chart1.UpdateSeriesAsync();
            await _chart2.UpdateSeriesAsync();
            await _chart3.UpdateSeriesAsync();
            await _chart4.UpdateSeriesAsync();
        });

        _hubConnection.On<List<SimulationTelemetry>>("ReceiveHistory", async history =>
        {
            _telemetryHistory = history;

            if (_telemetryHistory.Any())
            {
                _telemetryData = _telemetryHistory.Last();
            }

            await InvokeAsync(StateHasChanged);

            await _chart1.UpdateSeriesAsync();
            await _chart2.UpdateSeriesAsync();
            await _chart3.UpdateSeriesAsync();
            await _chart4.UpdateSeriesAsync();
        });

        SimulationService.OnStatusChanged += StateHasChanged;

        try
        {
            await _hubConnection.StartAsync();
            _connectionStatus = "Connected";
        }
        catch (Exception ex)
        {
            _connectionStatus = ex.Message;
        }
    }

    private bool IsConnected => _hubConnection?.State == HubConnectionState.Connected;

    private async Task Pause()
    {
        await SendUpdate(true);
    }

    private async Task Resume()
    {
        await SendUpdate(false);
    }

    private async Task Reset()
    {
        _telemetryData = new SimulationTelemetry();
        _telemetryHistory = [];
        await SimulationService.SendCommandAsync("RESET");
    }

    private async Task UpdateSpeed(int speed)
    {
        await SendUpdate(speed: speed);
    }

    private async Task UpdateStep(int step)
    {
        await SendUpdate(step: step);
    }

    private async Task SendUpdate(bool? isPaused = null, int? speed = null, int? step = null)
    {
        var current = SimulationService.CurrentStatus?.Config ?? new SimulationConfig();

        var newConfig = new SimulationConfig
        {
            IsPaused = isPaused ?? current.IsPaused,
            SimulationSpeed = speed ?? current.SimulationSpeed,
            SimulationStep = step ?? current.SimulationStep
        };

        await SimulationService.SendCommandAsync("UPDATE_CONFIG", newConfig);
    }

    private ApexChartOptions<SimulationTelemetry> GenerateOptions(string unitSuffix)
    {
        return new ApexChartOptions<SimulationTelemetry>
        {
            Chart = new Chart
            {
                Height = 300,
                Type = ChartType.Line,
                Animations = new Animations { Enabled = false },
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false }
            },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels { Format = "HH:mm" },
                Tooltip = new XAxisTooltip { Enabled = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = $"function (value) {{ return value.toFixed(0) + '{unitSuffix}'; }}"
                    }
                }
            ],
            Tooltip = new Tooltip
            {
                X = new TooltipX { Format = "dd-MM-yyyy HH:mm" }
            }
        };
    }

    public async ValueTask DisposeAsync()
    {
        SimulationService.OnStatusChanged -= StateHasChanged;

        if (_hubConnection is not null) await _hubConnection.DisposeAsync();
    }

}