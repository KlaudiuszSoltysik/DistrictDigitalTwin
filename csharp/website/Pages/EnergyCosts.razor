@page "/admin-panel/energy_costs"

@inject SimulationStatusService SimulationStatusService
@using shared
@using website.Components
@implements IAsyncDisposable

<PageTitle>DDT Energy Costs</PageTitle>

<EnergyCostsCharts @ref="_energyCostsChartsComponent"/>

@code {
    private EnergyCostsCharts? _energyCostsChartsComponent;

    protected override async Task OnInitializedAsync()
    {
        SimulationStatusService.OnSimulationTelemetryReceived += HandleNewSimulationTelemetry;
        SimulationStatusService.OnSimulationTelemetryDbReceived += HandleSimulationTelemetryDb;
        SimulationStatusService.OnDigitalTwinTelemetryReceived += HandleDigitalTwinTelemetry;

        SimulationStatusService.OnStatusChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _energyCostsChartsComponent != null)
        {
            if (SimulationStatusService.SimulationTelemetry.Any())
                await _energyCostsChartsComponent.LoadSimulationTelemetryAsync(SimulationStatusService.SimulationTelemetry);

            if (SimulationStatusService.DigitalTwinTelemetry.Any())
                await _energyCostsChartsComponent.LoadDigitalTwinTelemetryAsync(SimulationStatusService.DigitalTwinTelemetry);
        }
    }

    private async void HandleNewSimulationTelemetry(Telemetry msg)
    {
        if (_energyCostsChartsComponent != null)
        {
            await _energyCostsChartsComponent.AddSimulationTelemetryAsync(msg);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void HandleSimulationTelemetryDb(List<Telemetry> msgs)
    {
        if (_energyCostsChartsComponent != null)
        {
            await _energyCostsChartsComponent.LoadSimulationTelemetryAsync(msgs);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void HandleDigitalTwinTelemetry(List<Telemetry> msgs)
    {
        if (_energyCostsChartsComponent != null)
        {
            await _energyCostsChartsComponent.LoadDigitalTwinTelemetryAsync(msgs);
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        SimulationStatusService.OnSimulationTelemetryReceived -= HandleNewSimulationTelemetry;
        SimulationStatusService.OnSimulationTelemetryDbReceived -= HandleSimulationTelemetryDb;
        SimulationStatusService.OnDigitalTwinTelemetryReceived -= HandleDigitalTwinTelemetry;
        SimulationStatusService.OnStatusChanged -= StateHasChanged;
    }

}