@page "/"

@inject IConfiguration Config
@inject SimulationUiService SimulationService
@using shared
@implements IAsyncDisposable

<PageTitle>District Digital Twin</PageTitle>

<h3>Pulpit Symulacji</h3>

<div class="card p-3 shadow-sm">
    <h4>🎮 Control Panel</h4>

    @if (SimulationService.CurrentStatus?.Config == null)
    {
        <div class="alert alert-warning">Oczekiwanie na status symulacji...</div>
    }
    else
    {
        var config = SimulationService.CurrentStatus.Config;

        <div class="d-flex gap-2 mb-3">
            @if (config.IsPaused)
            {
                <button class="btn btn-success" @onclick="Resume">▶ Start</button>
            }
            else
            {
                <button class="btn btn-warning" @onclick="Pause">⏸ Pauza</button>
            }

            <button class="btn btn-danger" @onclick="Reset">🔄 Reset</button>
        </div>

        <div class="mb-3">
            <label>Prędkość symulacji: <strong>x@(config.SimulationSpeed)</strong></label>
            <input type="range" class="form-range" min="1" max="100" step="1"
                   value="@config.SimulationSpeed"
                   @onchange="UpdateSpeed"/>
        </div>

        <div class="mb-3">
            <label>Krok czasowy (s): <strong>@(config.SimulationStep)s</strong></label>
            <input type="number" class="form-control" value="@config.SimulationStep" @onchange="UpdateStep"/>
        </div>
    }
</div>

<div class="mb-3">
    <strong>Status:</strong> <span style="color: @(IsConnected ? "green" : "red")">@_connectionStatus</span>
    <span> | Załadowana historia: <strong>@_telemetryHistory.Count</strong> punktów</span>
</div>

@if (_telemetryData == null && _telemetryHistory.Count == 0)
{
    <p><em>Łączenie i pobieranie danych...</em></p>
}
else
{
    <div style="display: flex; gap: 20px;">

        <div style="flex: 1; border: 1px solid #ccc; padding: 10px;">
            <h4>Ostatni odczyt</h4>
            @if (_telemetryData != null)
            {
                <pre
                    style="font-size: 0.8em;">@JsonSerializer.Serialize(_telemetryData, new JsonSerializerOptions { WriteIndented = true })</pre>
            }
            else
            {
                <p>Czekam na nowy punkt...</p>
            }
        </div>

        <div style="flex: 1; border: 1px solid #ccc; padding: 10px;">
            <h4>Ostatnie 7 dni (Cache)</h4>
            <div style="height: 400px; overflow-y: scroll;">
                <table class="table table-sm text-xs">
                    <thead>
                    <tr>
                        <th>Czas</th>
                        <th>Temp Zew.</th>
                        <th>Pokoje</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Enumerable.Reverse(_telemetryHistory))
                    {
                        <tr>
                            <td>@item.Timestamp.ToString("dd.MM HH:mm")</td>
                            <td>@(item.Weather.Temperature.ToString("F1")) °C</td>
                            <td>@(item.RoomTemperatures.Count)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private HubConnection? _hubConnection;
    private SimulationTelemetry? _telemetryData;

    private List<SimulationTelemetry> _telemetryHistory = [];

    private string _connectionStatus = "Disconnected";

    protected override async Task OnInitializedAsync()
    {
        var baseApiUrl = Config["BaseApiUrl"];

        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{baseApiUrl}/hubs/simulation")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<SimulationTelemetry>("ReceiveSimulationData", data =>
        {
            _telemetryData = data;
            _telemetryHistory.Add(data);

            if (_telemetryHistory.Count > 2000) _telemetryHistory.RemoveAt(0);

            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<List<SimulationTelemetry>>("ReceiveHistory", history =>
        {
            _telemetryHistory = history;

            if (_telemetryHistory.Any())
            {
                _telemetryData = _telemetryHistory.Last();
            }

            InvokeAsync(StateHasChanged);
        });

        SimulationService.OnStatusChanged += StateHasChanged;

        try
        {
            await _hubConnection.StartAsync();
            _connectionStatus = "Connected";
        }
        catch (Exception ex)
        {
            _connectionStatus = ex.Message;
        }
    }

    private bool IsConnected => _hubConnection?.State == HubConnectionState.Connected;

    private async Task Pause()
    {
        await SendUpdate(true);
    }

    private async Task Resume()
    {
        await SendUpdate(false);
    }

    private async Task UpdateSpeed(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var speed))
        {
            await SendUpdate(speed: speed);
        }
    }

    private async Task UpdateStep(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var step))
        {
            await SendUpdate(step: step);
        }
    }

    private async Task SendUpdate(bool? isPaused = null, int? speed = null, int? step = null)
    {
        var current = SimulationService.CurrentStatus.Config;

        var newConfig = new SimulationConfig
        {
            IsPaused = isPaused ?? current.IsPaused,
            SimulationSpeed = speed ?? current.SimulationSpeed,
            SimulationStep = step ?? current.SimulationStep
        };

        await SimulationService.SendCommandAsync("UPDATE_CONFIG", newConfig);
    }

    private async Task Reset()
    {
        await SimulationService.SendCommandAsync("RESET");
    }

    public async ValueTask DisposeAsync()
    {
        SimulationService.OnStatusChanged -= StateHasChanged;

        if (_hubConnection is not null) await _hubConnection.DisposeAsync();
    }

}