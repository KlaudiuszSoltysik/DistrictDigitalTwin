@page "/"

@inject IConfiguration Config
@using shared
@implements IAsyncDisposable

<PageTitle>Smart District Dashboard</PageTitle>

<h3>Pulpit Symulacji</h3>

<div class="mb-3">
    <strong>Status:</strong> <span style="color: @(IsConnected ? "green" : "red")">@_connectionStatus</span>
    <span> | Załadowana historia: <strong>@_historyList.Count</strong> punktów</span>
</div>

@if (_telemetryData == null && _historyList.Count == 0)
{
    <p><em>Łączenie i pobieranie danych...</em></p>
}
else
{
    <div style="display: flex; gap: 20px;">

        <div style="flex: 1; border: 1px solid #ccc; padding: 10px;">
            <h4>Ostatni odczyt</h4>
            @if (_telemetryData != null)
            {
                <pre
                    style="font-size: 0.8em;">@JsonSerializer.Serialize(_telemetryData, new JsonSerializerOptions { WriteIndented = true })</pre>
            }
            else
            {
                <p>Czekam na nowy punkt...</p>
            }
        </div>

        <div style="flex: 1; border: 1px solid #ccc; padding: 10px;">
            <h4>Ostatnie 7 dni (Cache)</h4>
            <div style="height: 400px; overflow-y: scroll;">
                <table class="table table-sm text-xs">
                    <thead>
                    <tr>
                        <th>Czas</th>
                        <th>Temp Zew.</th>
                        <th>Pokoje</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Enumerable.Reverse(_historyList))
                    {
                        <tr>
                            <td>@item.Timestamp.ToString("dd.MM HH:mm")</td>
                            <td>@(item.Weather.Temperature.ToString("F1")) °C</td>
                            <td>@(item.RoomTemperatures.Count)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private HubConnection? _hubConnection;
    private SimulationTelemetry? _telemetryData;

    private List<SimulationTelemetry> _historyList = [];

    private string _connectionStatus = "Disconnected";

    protected override async Task OnInitializedAsync()
    {
        var baseApiUrl = Config["BaseApiUrl"];
        if (string.IsNullOrEmpty(baseApiUrl)) return;

        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{baseApiUrl}/hubs/simulation")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<SimulationTelemetry>("ReceiveSimulationData", data =>
        {
            _telemetryData = data;
            _historyList.Add(data);

            if (_historyList.Count > 2000) _historyList.RemoveAt(0);

            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<List<SimulationTelemetry>>("ReceiveHistory", history =>
        {
            Console.WriteLine($"Otrzymano {history.Count} punktów historii z cache!");
            _historyList = history;

            if (_historyList.Any())
            {
                _telemetryData = _historyList.Last();
            }

            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
            _connectionStatus = "Connected";
        }
        catch (Exception ex)
        {
            _connectionStatus = $"Error: {ex.Message}";
        }
    }

    private bool IsConnected => _hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null) await _hubConnection.DisposeAsync();
    }

}