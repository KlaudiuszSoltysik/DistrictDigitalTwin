@page "/admin-panel/weather"

@inject SimulationStatusService SimulationStatusService
@using shared
@using website.Components
@implements IAsyncDisposable

<PageTitle>DDT Weather</PageTitle>

<WeatherCharts @ref="_telemetryChartsComponent"/>

@code {

    private WeatherCharts? _telemetryChartsComponent;

    protected override async Task OnInitializedAsync()
    {
        SimulationStatusService.OnSimulationTelemetryReceived += HandleNewSimulationTelemetry;
        SimulationStatusService.OnSimulationTelemetryDbReceived += HandleSimulationTelemetryDb;
        SimulationStatusService.OnDigitalTwinTelemetryReceived += HandleDigitalTwinTelemetry;

        SimulationStatusService.OnStatusChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _telemetryChartsComponent != null)
        {
            if (SimulationStatusService.SimulationTelemetry.Any())
                await _telemetryChartsComponent.LoadSimulationTelemetryAsync(SimulationStatusService.SimulationTelemetry);

            if (SimulationStatusService.DigitalTwinTelemetry.Any())
                await _telemetryChartsComponent.LoadDigitalTwinTelemetryAsync(SimulationStatusService.DigitalTwinTelemetry);
        }
    }

    private async void HandleNewSimulationTelemetry(Telemetry msg)
    {
        if (_telemetryChartsComponent != null)
        {
            await _telemetryChartsComponent.AddSimulationTelemetryAsync(msg);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void HandleSimulationTelemetryDb(List<Telemetry> msgs)
    {
        if (_telemetryChartsComponent != null)
        {
            await _telemetryChartsComponent.LoadSimulationTelemetryAsync(msgs);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void HandleDigitalTwinTelemetry(List<Telemetry> msgs)
    {
        if (_telemetryChartsComponent != null)
        {
            await _telemetryChartsComponent.LoadDigitalTwinTelemetryAsync(msgs);
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        SimulationStatusService.OnSimulationTelemetryReceived -= HandleNewSimulationTelemetry;
        SimulationStatusService.OnSimulationTelemetryDbReceived -= HandleSimulationTelemetryDb;
        SimulationStatusService.OnDigitalTwinTelemetryReceived -= HandleDigitalTwinTelemetry;
        SimulationStatusService.OnStatusChanged -= StateHasChanged;
    }

}