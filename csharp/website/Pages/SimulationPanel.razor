@page "/admin-panel"

@inject IConfiguration Config
@inject SimulationStatusService SimulationStatusService
@using shared
@using website.Components
@implements IAsyncDisposable

<PageTitle>District Digital Twin - Admin Panel</PageTitle>

<SimulationControls
    IsConnected="@IsConnected"
    ConnectionStatus="@_connectionStatus"
    DigitalTwinTimestamp="@_digitalTwinTimestamp"
    Config="@SimulationStatusService.CurrentStatus?.Config"
    OnResume="Resume"
    OnPause="Pause"
    OnReset="Reset"
    OnSpeedChange="UpdateSpeed"
    OnStepChange="UpdateStep"
    OnSigmaChange="UpdateSigma"
/>

<TelemetryCharts @ref="_telemetryChartsComponent"/>

<TelemetryJson SimulationTelemetry="_simulationTelemetry" DigitalTwinTelemetry="_digitalTwinTelemetry"/>

@code {

    private HubConnection? _hubConnection;
    private string _connectionStatus = "Disconnected";
    private DateTimeOffset _digitalTwinTimestamp;

    private List<Telemetry> _simulationTelemetry = [];
    private List<Telemetry> _digitalTwinTelemetry = [];

    private TelemetryCharts? _telemetryChartsComponent;

    protected override async Task OnInitializedAsync()
    {
        var baseApiUrl = Config["BaseApiUrl"];

        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{baseApiUrl}hubs/simulation")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<Telemetry>("ReceiveSimulationTelemetry", async msg =>
        {
            _simulationTelemetry.Add(msg);

            var cutoffTime = msg.Timestamp.AddHours(-24);

            while (_simulationTelemetry.Count > 0 && _simulationTelemetry[0].Timestamp < cutoffTime)
            {
                _simulationTelemetry.RemoveAt(0);
            }

            if (_telemetryChartsComponent != null)
            {
                await _telemetryChartsComponent.AddSimulationTelemetryAsync(msg);
            }

            await InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<List<Telemetry>>("ReceiveSimulationTelemetryDb", async msgs =>
        {
            _simulationTelemetry = msgs;

            if (_telemetryChartsComponent != null)
            {
                await _telemetryChartsComponent.LoadSimulationTelemetryAsync(msgs);
            }

            await InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<List<Telemetry>>("ReceiveDigitalTwinTelemetry", async msg =>
        {
            _digitalTwinTimestamp = msg[0].Timestamp;

            foreach (var incomingItem in msg)
            {
                var existingIndex = _digitalTwinTelemetry.FindIndex(t => t.Timestamp == incomingItem.Timestamp);

                if (existingIndex >= 0)
                {
                    _digitalTwinTelemetry[existingIndex] = incomingItem;
                }
                else
                {
                    _digitalTwinTelemetry.Add(incomingItem);
                }
            }

            _digitalTwinTelemetry = _digitalTwinTelemetry.OrderBy(t => t.Timestamp).ToList();

            if (_telemetryChartsComponent != null)
            {
                await _telemetryChartsComponent.LoadDigitalTwinTelemetryAsync(_digitalTwinTelemetry);
            }

            await InvokeAsync(StateHasChanged);
        });

        SimulationStatusService.OnStatusChanged += StateHasChanged;

        try
        {
            await _hubConnection.StartAsync();
            _connectionStatus = "Connected";
        }
        catch (Exception ex)
        {
            _connectionStatus = ex.Message;
        }
    }

    private bool IsConnected => _hubConnection?.State == HubConnectionState.Connected;

    private async Task Pause()
    {
        await SendUpdate(true);
    }

    private async Task Resume()
    {
        await SendUpdate(false);
    }

    private async Task Reset()
    {
        _simulationTelemetry.Clear();
        _digitalTwinTelemetry.Clear();

        if (_telemetryChartsComponent != null)
        {
            await _telemetryChartsComponent.ClearChartsAsync();
        }

        StateHasChanged();

        await SimulationStatusService.SendCommandAsync("RESET");
    }

    private async Task UpdateSpeed(int speed)
    {
        await SendUpdate(speed: speed);
    }

    private async Task UpdateStep(int step)
    {
        await SendUpdate(step: step);
    }

    private async Task UpdateSigma(double sigma)
    {
        await SendUpdate(sigma: sigma);
    }

    private async Task SendUpdate(bool? isPaused = null, int? speed = null, int? step = null, double? sigma = null)
    {
        var current = SimulationStatusService.CurrentStatus?.Config ?? new SimulationConfig();

        var newConfig = new SimulationConfig
        {
            IsPaused = isPaused ?? current.IsPaused,
            SimulationSpeed = speed ?? current.SimulationSpeed,
            SimulationStep = step ?? current.SimulationStep,
            RoomTemperatureNoiseSigma = sigma ?? current.RoomTemperatureNoiseSigma
        };

        await SimulationStatusService.SendCommandAsync("UPDATE_CONFIG", newConfig);
    }

    public async ValueTask DisposeAsync()
    {
        SimulationStatusService.OnStatusChanged -= StateHasChanged;

        if (_hubConnection is not null) await _hubConnection.DisposeAsync();
    }

}