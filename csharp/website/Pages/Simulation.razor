@page "/admin-panel/simulation"

@inject SimulationStatusService SimulationStatusService
@using shared
@using website.Components
@implements IAsyncDisposable

<PageTitle>District Digital Twin - Admin Panel</PageTitle>

<SimulationControls
    SimulationTimestamp="@SimulationStatusService.SimulationTimestamp"
    DigitalTwinTimestamp="@SimulationStatusService.DigitalTwinTimestamp"
    Config="@SimulationStatusService.CurrentStatus?.Config"
    OnResume="Resume"
    OnPause="Pause"
    OnReset="Reset"
    OnSpeedChange="UpdateSpeed"
    OnStepChange="UpdateStep"
    OnSigmaChange="UpdateSigma"
/>

<TelemetryCharts @ref="_telemetryChartsComponent"/>

<TelemetryJson SimulationTelemetry="SimulationStatusService.SimulationTelemetry"
               DigitalTwinTelemetry="SimulationStatusService.DigitalTwinTelemetry"/>

@code {

    private TelemetryCharts? _telemetryChartsComponent;

    protected override async Task OnInitializedAsync()
    {
        SimulationStatusService.OnSimulationTelemetryReceived += HandleNewSimulationTelemetry;
        SimulationStatusService.OnSimulationTelemetryDbReceived += HandleSimulationTelemetryDb;
        SimulationStatusService.OnDigitalTwinTelemetryReceived += HandleDigitalTwinTelemetry;

        SimulationStatusService.OnStatusChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _telemetryChartsComponent != null)
        {
            if (SimulationStatusService.SimulationTelemetry.Any())
                await _telemetryChartsComponent.LoadSimulationTelemetryAsync(SimulationStatusService.SimulationTelemetry);

            if (SimulationStatusService.DigitalTwinTelemetry.Any())
                await _telemetryChartsComponent.LoadDigitalTwinTelemetryAsync(SimulationStatusService.DigitalTwinTelemetry);
        }
    }

    private async void HandleNewSimulationTelemetry(Telemetry msg)
    {
        if (_telemetryChartsComponent != null)
        {
            await _telemetryChartsComponent.AddSimulationTelemetryAsync(msg);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void HandleSimulationTelemetryDb(List<Telemetry> msgs)
    {
        if (_telemetryChartsComponent != null)
        {
            await _telemetryChartsComponent.LoadSimulationTelemetryAsync(msgs);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void HandleDigitalTwinTelemetry(List<Telemetry> msgs)
    {
        if (_telemetryChartsComponent != null)
        {
            await _telemetryChartsComponent.LoadDigitalTwinTelemetryAsync(msgs);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task Reset()
    {
        await SimulationStatusService.SendCommandAsync("RESET");
        await Task.Delay(200);

        SimulationStatusService.ClearTelemetry();

        if (_telemetryChartsComponent != null)
        {
            await _telemetryChartsComponent.ClearChartsAsync();
        }

        StateHasChanged();
    }

    private async Task Pause()
    {
        await SendSimulationUpdate(true);
    }

    private async Task Resume()
    {
        await SendSimulationUpdate(false);
    }

    private async Task UpdateSpeed(int speed)
    {
        await SendSimulationUpdate(speed: speed);
    }

    private async Task UpdateStep(int step)
    {
        await SendSimulationUpdate(step: step);
    }

    private async Task UpdateSigma(double sigma)
    {
        await SendSimulationUpdate(sigma: sigma);
    }

    private async Task SendSimulationUpdate(bool? isPaused = null, int? speed = null, int? step = null, double? sigma = null)
    {
        var current = SimulationStatusService.CurrentStatus?.Config ?? new Config();

        var newConfig = new Config
        {
            IsPaused = isPaused ?? current.IsPaused,
            SimulationSpeed = speed ?? current.SimulationSpeed,
            SimulationStep = step ?? current.SimulationStep,
            RoomTemperatureNoiseSigma = sigma ?? current.RoomTemperatureNoiseSigma
        };

        await SimulationStatusService.SendCommandAsync("UPDATE_SIMULATION_CONFIG", targetConfig: newConfig);
    }

    public async ValueTask DisposeAsync()
    {
        SimulationStatusService.OnSimulationTelemetryReceived -= HandleNewSimulationTelemetry;
        SimulationStatusService.OnSimulationTelemetryDbReceived -= HandleSimulationTelemetryDb;
        SimulationStatusService.OnDigitalTwinTelemetryReceived -= HandleDigitalTwinTelemetry;
        SimulationStatusService.OnStatusChanged -= StateHasChanged;
    }

}