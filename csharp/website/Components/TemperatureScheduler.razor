<div
    class="flex items-end justify-between h-80 gap-1 sm:gap-2 bg-gray-900 border border-gray-700 p-4 rounded-xl shadow-inner">
    @for (var i = 0; i < 24; i++)
    {
        var hour = i;

        <div class="flex flex-col items-center w-full h-full">
            <span class="text-[10px] sm:text-xs font-bold text-indigo-400 mb-4 h-4 transition-all">
                @Temperatures[hour].ToString("F1")°
            </span>

            <div class="relative h-56 w-6 flex items-center justify-center">
                <input type="range"
                       min="16.0"
                       max="26.0"
                       step="0.1"
                       class="absolute w-56 h-1 bg-gray-700 rounded-lg appearance-none outline-none thermostat-range"
                       style="transform: rotate(-90deg);"
                       @bind="Temperatures[hour]"
                       @bind:event="oninput"/>
            </div>

            <span class="text-[10px] sm:text-xs text-gray-500 mt-4 font-medium">
                @(hour.ToString("00")):00
            </span>
        </div>
    }
</div>

@code {
    [Parameter] public double[] Temperatures { get; set; } = [];
}