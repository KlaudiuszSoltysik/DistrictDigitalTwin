<div class="p-6 flex flex-wrap gap-6 items-end">
    <div class="flex flex-col gap-2 w-full sm:w-48">
        <label class="font-medium uppercase text-xs text-gray-400">Building</label>
        <select @bind="_selectedBuilding" @bind:after="OnBuildingChangedAsync"
                class="bg-gray-800 border border-gray-700 text-sm font-medium rounded-md px-3 py-2.5 shadow-sm transition-all outline-none hover:bg-gray-700 hover:border-gray-600 focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600">
            <option value="All">All</option>
            @foreach (var opt in GetBuildingOptions())
            {
                <option value="@opt">@opt</option>
            }
        </select>
    </div>

    <div class="flex flex-col gap-2 w-full sm:w-48">
        <label class="font-medium uppercase text-xs text-gray-400">Apartment</label>
        <select @bind="_selectedApartment" @bind:after="OnApartmentChangedAsync"
                disabled="@(_selectedBuilding == "All")"
                class="bg-gray-800 border border-gray-700 text-sm font-medium rounded-md px-3 py-2.5 shadow-sm transition-all outline-none hover:bg-gray-700 hover:border-gray-600 focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-gray-800 disabled:hover:border-gray-700">
            <option value="All">All</option>
            @foreach (var opt in GetApartmentOptions())
            {
                <option value="@opt">@opt</option>
            }
        </select>
    </div>

    <div class="flex flex-col gap-2 w-full sm:w-48">
        <label class="font-medium uppercase text-xs text-gray-400">Room</label>
        <select @bind="_selectedRoom" @bind:after="OnRoomChangedAsync" disabled="@(_selectedApartment == "All")"
                class="bg-gray-800 border border-gray-700 text-sm font-medium rounded-md px-3 py-2.5 shadow-sm transition-all outline-none hover:bg-gray-700 hover:border-gray-600 focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-gray-800 disabled:hover:border-gray-700">
            <option value="All">All</option>
            @foreach (var opt in GetRoomOptions())
            {
                <option value="@opt">@opt</option>
            }
        </select>
    </div>
</div>

@code {
    [Parameter] public List<string> RoomNames { get; set; } = [];
    [Parameter] public EventCallback<List<string>> OnActiveRoomsChanged { get; set; }

    private string _selectedBuilding = "All";
    private string _selectedApartment = "All";
    private string _selectedRoom = "All";

    private IEnumerable<string> GetBuildingOptions()
    {
        return RoomNames.Select(k => k.Split(':')[0]).Distinct();
    }

    private IEnumerable<string> GetApartmentOptions()
    {
        return _selectedBuilding == "All" ? [] : RoomNames.Where(k => k.StartsWith($"{_selectedBuilding}:")).Select(k => k.Split(':')[1]).Distinct();
    }

    private IEnumerable<string> GetRoomOptions()
    {
        return _selectedApartment == "All" ? [] : RoomNames.Where(k => k.StartsWith($"{_selectedBuilding}:{_selectedApartment}:")).Select(k => k.Split(':')[2]).Distinct();
    }

    private async Task OnBuildingChangedAsync()
    {
        _selectedApartment = "All";
        _selectedRoom = "All";
        await NotifyParentAsync();
    }

    private async Task OnApartmentChangedAsync()
    {
        _selectedRoom = "All";
        await NotifyParentAsync();
    }

    private async Task OnRoomChangedAsync()
    {
        await NotifyParentAsync();
    }

    private async Task NotifyParentAsync()
    {
        var activeRooms = RoomNames.Where(key =>
        {
            var parts = key.Split(':');
            if (parts.Length < 3) return false;

            var match1 = _selectedBuilding == "All" || parts[0] == _selectedBuilding;
            var match2 = _selectedApartment == "All" || parts[1] == _selectedApartment;
            var match3 = _selectedRoom == "All" || parts[2] == _selectedRoom;

            return match1 && match2 && match3;
        }).ToList();

        await OnActiveRoomsChanged.InvokeAsync(activeRooms);
    }

}