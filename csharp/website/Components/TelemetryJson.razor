@using shared
<div class="flex flex-2 gap-4">
    <div class="flex-1 border border-gray-700 rounded-xl overflow-hidden select-none">

        <div class="bg-gray-800 px-6 py-4 border-b border-gray-700 flex items-center justify-between">
            <p class="text-xl font-bold text-white m-0">Simulation telemetry (@SimulationTelemetry.Count frames)</p>
            @if (_expandedSimulationItems.Count > 0)
            {
                <button class="text-xs font-bold text-gray-400 hover:text-white transition-all uppercase tracking-wider"
                        @onclick="CollapseSimulationAll">
                    Collapse all
                </button>
            }
        </div>

        <div class="h-[600px] overflow-y-auto p-4 space-y-2 bg-transparent custom-scroll">

            @foreach (var item in Enumerable.Reverse(SimulationTelemetry))
            {
                var isExpanded = _expandedSimulationItems.Contains(item.Timestamp);

                <div class="border border-gray-700 rounded-md bg-gray-800 overflow-hidden shadow-sm">

                    <div
                        class="flex items-center justify-between px-4 py-3 cursor-pointer hover:bg-gray-700 transition-colors"
                        @onclick="() => ToggleSimulationExpand(item.Timestamp)">

                        <span class="font-mono text-sm text-gray-200">
                            @item.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")
                        </span>

                        <div
                            class="w-6 h-6 flex items-center justify-center rounded bg-gray-900 border border-gray-700 text-gray-400 transition-all">
                            <span class="font-bold text-lg leading-none pb-0.5">
                                @(isExpanded ? "−" : "+")
                            </span>
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="p-4 border-t border-gray-700 bg-gray-900">
                            <pre
                                class="text-xs text-gray-300 m-0 overflow-x-auto">@JsonSerializer.Serialize(item, _jsonOptions)</pre>
                        </div>
                    }
                </div>
            }

        </div>
    </div>

    <div class="flex-1 border border-gray-700 rounded-xl overflow-hidden select-none">

        <div class="bg-gray-800 px-6 py-4 border-b border-gray-700 flex items-center justify-between">
            <p class="text-xl font-bold text-white m-0">Digital Twin telemetry (@DigitalTwinTelemetry.Count frames)</p>
            @if (_expandedDigitalTwinItems.Count > 0)
            {
                <button class="text-xs font-bold text-gray-400 hover:text-white transition-all uppercase tracking-wider"
                        @onclick="CollapseDigitalTwinAll">
                    Collapse all
                </button>
            }
        </div>

        <div class="h-[600px] overflow-y-auto p-4 space-y-2 bg-transparent custom-scroll">

            @foreach (var item in Enumerable.Reverse(DigitalTwinTelemetry))
            {
                var isExpanded = _expandedDigitalTwinItems.Contains(item.Timestamp);

                <div class="border border-gray-700 rounded-md bg-gray-800 overflow-hidden shadow-sm">

                    <div
                        class="flex items-center justify-between px-4 py-3 cursor-pointer hover:bg-gray-700 transition-colors"
                        @onclick="() => ToggleDigitalTwinExpand(item.Timestamp)">

                        <span class="font-mono text-sm text-gray-200">
                            @item.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")
                        </span>

                        <div
                            class="w-6 h-6 flex items-center justify-center rounded bg-gray-900 border border-gray-700 text-gray-400 transition-all">
                            <span class="font-bold text-lg leading-none pb-0.5">
                                @(isExpanded ? "−" : "+")
                            </span>
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="p-4 border-t border-gray-700 bg-gray-900">
                            <pre
                                class="text-xs text-gray-300 m-0 overflow-x-auto">@JsonSerializer.Serialize(item, _jsonOptions)</pre>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>

@code {
    [Parameter] public List<Telemetry> SimulationTelemetry { get; set; } = [];
    [Parameter] public List<Telemetry> DigitalTwinTelemetry { get; set; } = [];

    private readonly HashSet<DateTime> _expandedSimulationItems = [];
    private readonly HashSet<DateTime> _expandedDigitalTwinItems = [];

    private readonly JsonSerializerOptions _jsonOptions = new() { WriteIndented = true };

    private void ToggleSimulationExpand(DateTime timestamp)
    {
        if (!_expandedSimulationItems.Add(timestamp))
        {
            _expandedSimulationItems.Remove(timestamp);
        }
    }

    private void CollapseSimulationAll()
    {
        _expandedSimulationItems.Clear();
    }

    private void ToggleDigitalTwinExpand(DateTime timestamp)
    {
        if (!_expandedDigitalTwinItems.Add(timestamp))
        {
            _expandedDigitalTwinItems.Remove(timestamp);
        }
    }

    private void CollapseDigitalTwinAll()
    {
        _expandedDigitalTwinItems.Clear();
    }

}