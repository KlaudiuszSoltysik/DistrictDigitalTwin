@using shared
@if (TelemetryHistory.Count != 0)
{
    <div class="flex-1 border border-gray-700 rounded-xl overflow-hidden select-none">

        <div class="bg-gray-800 px-6 py-4 border-b border-gray-700 flex items-center justify-between">
            <p class="text-xl font-bold text-white m-0">History (@TelemetryHistory.Count frames)</p>
            @if (_expandedItems.Count > 0)
            {
                <button class="text-xs font-bold text-gray-400 hover:text-white transition-all uppercase tracking-wider"
                        @onclick="CollapseAll">
                    Collapse all
                </button>
            }
        </div>

        <div class="h-[400px] overflow-y-auto p-4 space-y-2 bg-transparent custom-scroll">

            @foreach (var item in Enumerable.Reverse(TelemetryHistory))
            {
                var isExpanded = _expandedItems.Contains(item.Timestamp);

                <div class="border border-gray-700 rounded-md bg-gray-800 overflow-hidden shadow-sm">

                    <div class="flex items-center justify-between px-4 py-3 cursor-pointer hover:bg-gray-700 transition-colors"
                         @onclick="() => ToggleExpand(item.Timestamp)">

                        <span class="font-mono text-sm text-gray-200">
                            @item.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")
                        </span>

                        <div class="w-6 h-6 flex items-center justify-center rounded bg-gray-900 border border-gray-700 text-gray-400 transition-all">
                            <span class="font-bold text-lg leading-none pb-0.5">
                                @(isExpanded ? "−" : "+")
                            </span>
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="p-4 border-t border-gray-700 bg-gray-900">
                            <pre class="text-xs text-gray-300 m-0 overflow-x-auto">@JsonSerializer.Serialize(item, _jsonOptions)</pre>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
}

@code {
    [Parameter] public List<SimulationTelemetry> TelemetryHistory { get; set; } = [];

    private readonly HashSet<DateTime> _expandedItems = [];

    private readonly JsonSerializerOptions _jsonOptions = new() { WriteIndented = true };

    private void ToggleExpand(DateTime timestamp)
    {
        if (!_expandedItems.Add(timestamp))
        {
            _expandedItems.Remove(timestamp);
        }
    }

    private void CollapseAll()
    {
        _expandedItems.Clear();
    }

}