<div
    class="my-10 border rounded-xl overflow-hidden select-none shadow-2xl transition-all duration-300 @(IsActive ? "border-gray-700" : "border-gray-800")">

    <div class="bg-gray-800 px-6 py-4 border-b border-gray-700 flex items-center justify-between">
        <p class="text-xl font-bold transition-colors @(IsActive ? "text-white" : "text-gray-500")">@(Name)</p>

        <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" class="sr-only peer" checked="@IsActive" @onchange="OnMasterSwitchChanged"/>
            <div
                class="w-11 h-6 bg-gray-600 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-gray-200 after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-500 transition-colors"></div>
            <span class="ml-3 text-sm font-bold w-8 @(IsActive ? "text-indigo-400" : "text-gray-500")">
                @(IsActive ? "ON" : "OFF")
            </span>
        </label>
    </div>

    <div
        class="flex items-end justify-between h-[26rem] gap-1 sm:gap-2 bg-gray-900 p-6 shadow-inner transition-opacity duration-300">

        @for (var i = 0; i < 24; i++)
        {
            var hour = i;
            var isHourEnabled = IsEnabled[hour];

            <div
                class="flex flex-col items-center w-full h-full transition-all duration-300 @(isHourEnabled ? "opacity-100" : "opacity-40 grayscale")">
                <span
                    class="text-[10px] sm:text-xs font-bold @(isHourEnabled ? "text-indigo-400" : "text-gray-500") mb-4 h-4 transition-colors">
                    @Temperatures[hour].ToString("F1")°
                </span>

                <div class="relative h-64 w-6 flex items-center justify-center">
                    <input type="range"
                           min="16.0"
                           max="26.0"
                           step="0.1"
                           disabled="@(!isHourEnabled)"
                           class="absolute w-64 h-1 bg-gray-800 rounded-lg appearance-none outline-none thermostat-range @(isHourEnabled ? "cursor-pointer" : "cursor-not-allowed")"
                           style="transform: rotate(-90deg);"
                           @bind="Temperatures[hour]"
                           @bind:event="oninput"
                           @bind:after="NotifyTemperaturesChanged"/>
                </div>

                <label class="relative inline-flex items-center cursor-pointer mt-4 mb-1" title="Enable/Disable hour">
                    <input type="checkbox"
                           class="sr-only peer"
                           @bind="IsEnabled[hour]"
                           @bind:after="NotifyIsEnabledChanged"/>
                    <div
                        class="w-8 h-4 bg-gray-700 rounded-full peer peer-checked:after:translate-x-4 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-gray-300 after:border-gray-500 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-indigo-500 transition-colors hover:bg-gray-600"></div>
                </label>

                <span
                    class="text-[10px] sm:text-xs @(isHourEnabled ? "text-gray-400" : "text-gray-600") mt-1 font-medium uppercase tracking-tighter">
                    @(hour.ToString("00"))
                </span>
            </div>
        }

        <div class="w-px h-full bg-gray-700 mx-2 self-stretch"></div>

        <div
            class="flex flex-col items-center w-24 h-full bg-gray-800/30 rounded-lg p-1 border border-gray-800 shadow-lg">
            <span class="text-[10px] sm:text-xs font-bold text-fuchsia-400 mb-4 h-4 transition-all">
                ±@Tolerance.ToString("F1")°
            </span>

            <div class="relative h-64 w-8 flex items-center justify-center">
                <input type="range"
                       min="0.1"
                       max="10.0"
                       step="0.1"
                       class="absolute w-64 h-2 bg-gray-700 rounded-lg appearance-none outline-none thermostat-range cursor-ns-resize"
                       style="transform: rotate(-90deg);"
                       @bind="Tolerance"
                       @@bind:event="oninput"
                       @bind:event="oninput"
                       @bind:after="NotifyToleranceChanged"/>
            </div>

            <span class="text-[10px] sm:text-xs text-fuchsia-500/70 mt-auto mb-1 font-bold uppercase tracking-widest">
                Tolerance
            </span>
        </div>

        <div
            class="flex flex-col items-center w-24 h-full bg-gray-800/30 rounded-lg p-1 border border-gray-800 shadow-lg">
            <span class="text-[10px] sm:text-xs font-bold text-fuchsia-400 mb-4 h-4 transition-all">
                @Co2.ToString() ppm
            </span>

            <div class="relative h-64 w-8 flex items-center justify-center">
                <input type="range"
                       min="400"
                       max="1000"
                       step="25"
                       class="absolute w-64 h-2 bg-gray-700 rounded-lg appearance-none outline-none thermostat-range cursor-ns-resize"
                       style="transform: rotate(-90deg);"
                       @bind="Co2"
                       @bind:event="oninput"
                       @bind:after="NotifyCo2Changed"/>
            </div>

            <span class="text-[10px] sm:text-xs text-fuchsia-500/70 mt-auto mb-1 font-bold uppercase tracking-widest">
                CO₂
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter] public required string Name { get; set; }

    [Parameter] public List<double> Temperatures { get; set; } = [];
    [Parameter] public EventCallback<List<double>> TemperaturesChanged { get; set; }

    [Parameter] public int Co2 { get; set; }
    [Parameter] public EventCallback<int> Co2Changed { get; set; }

    [Parameter] public double Tolerance { get; set; }
    [Parameter] public EventCallback<double> ToleranceChanged { get; set; }

    [Parameter] public List<bool> IsEnabled { get; set; } = [];
    [Parameter] public EventCallback<List<bool>> IsEnabledChanged { get; set; }

    private async Task NotifyTemperaturesChanged()
    {
        await TemperaturesChanged.InvokeAsync(Temperatures);
    }

    private async Task NotifyCo2Changed()
    {
        await Co2Changed.InvokeAsync(Co2);
    }

    private async Task NotifyToleranceChanged()
    {
        await ToleranceChanged.InvokeAsync(Tolerance);
    }

    private async Task NotifyIsEnabledChanged()
    {
        await IsEnabledChanged.InvokeAsync(IsEnabled);
    }

    private bool IsActive => IsEnabled.Any(s => s);

    private void OnMasterSwitchChanged(ChangeEventArgs e)
    {
        if (e.Value is not bool val) return;

        for (var i = 0; i < 24; i++)
        {
            IsEnabled[i] = val;
        }
    }

}