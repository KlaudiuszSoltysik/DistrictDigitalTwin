@using shared
@if (_simulationTelemetry.Count != 0)
{
    <ApexChart TItem="Telemetry" Title="Temperature [°C]" Options="_temperatureChartOptions" @ref="_chart1">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Temperature forecast"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.Temperature)"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Temperature"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.Temperature)"/>
    </ApexChart>

    <ApexChart TItem="Telemetry" Title="Wind speed [km/h]" Options="_windSpeedChartOptions" @ref="_chart2">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Wind speed forecast"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.WindSpeed)"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Wind speed"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.WindSpeed)"/>
    </ApexChart>

    <ApexChart TItem="Telemetry" Title="Sun radiation [W/m²]" Options="_sunRadiationChartOptions"
               @ref="_chart3">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Sun radiation forecast"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.SunRadiation)"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Sun radiation"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.SunRadiation)"/>
    </ApexChart>

    <ApexChart TItem="Telemetry" Title="Sun altitude [°]" Options="_sunAltitudeChartOptions" @ref="_chart4">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Sun altitude forecast"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.SunAltitude)"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Sun altitude"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.SunAltitude)"/>
    </ApexChart>

    <ApexChart TItem="Telemetry" Title="CO₂ [ppm]" Options="_co2ChartOptions" @ref="_chart5">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="CO₂ forecast"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => t.Weather.Co2)"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="CO₂"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => t.Weather.Co2)"/>
    </ApexChart>
}



@code {
    private int _updateCounter;
    private List<Telemetry> _simulationTelemetry = [];
    private List<Telemetry> _digitalTwinTelemetry = [];

    private ApexChart<Telemetry> _chart1 = new();
    private ApexChart<Telemetry> _chart2 = new();
    private ApexChart<Telemetry> _chart3 = new();
    private ApexChart<Telemetry> _chart4 = new();
    private ApexChart<Telemetry> _chart5 = new();

    private ApexChartOptions<Telemetry> _temperatureChartOptions = new();
    private ApexChartOptions<Telemetry> _windSpeedChartOptions = new();
    private ApexChartOptions<Telemetry> _sunRadiationChartOptions = new();
    private ApexChartOptions<Telemetry> _sunAltitudeChartOptions = new();
    private ApexChartOptions<Telemetry> _co2ChartOptions = new();


    protected override void OnInitialized()
    {
        _temperatureChartOptions = GenerateOptions("°C");
        _windSpeedChartOptions = GenerateOptions(" km/h");
        _sunRadiationChartOptions = GenerateOptions(" W/m²");
        _sunAltitudeChartOptions = GenerateOptions("°");
        _co2ChartOptions = GenerateOptions(" ppm");
    }

    public async Task AddSimulationTelemetryAsync(Telemetry msg)
    {
        _updateCounter++;

        _simulationTelemetry.Add(msg);

        if (_updateCounter % 5 == 0)
        {
            var cutoffTime = msg.Timestamp.AddHours(-24);

            _simulationTelemetry.RemoveAll(t => t.Timestamp < cutoffTime);
            _digitalTwinTelemetry.RemoveAll(t => t.Timestamp < cutoffTime);

            await Task.WhenAll(
                InvokeAsync(StateHasChanged),
                _chart1.UpdateSeriesAsync(),
                _chart2.UpdateSeriesAsync(),
                _chart3.UpdateSeriesAsync(),
                _chart4.UpdateSeriesAsync(),
                _chart5.UpdateSeriesAsync()
            );
        }
    }

    public async Task LoadSimulationTelemetryAsync(List<Telemetry> msgs)
    {
        _simulationTelemetry = msgs;

        await InvokeAsync(StateHasChanged);
    }

    public async Task LoadDigitalTwinTelemetryAsync(List<Telemetry> msg)
    {
        _digitalTwinTelemetry = msg;

        await Task.WhenAll(
            InvokeAsync(StateHasChanged),
            _chart1.UpdateSeriesAsync(),
            _chart2.UpdateSeriesAsync(),
            _chart3.UpdateSeriesAsync(),
            _chart4.UpdateSeriesAsync(),
            _chart5.UpdateSeriesAsync()
        );
    }

    private static ApexChartOptions<Telemetry> GenerateOptions(string unitSuffix)
    {
        return new ApexChartOptions<Telemetry>
        {
            Chart = new Chart
            {
                Height = 300,
                Type = ChartType.Line,
                Animations = new Animations { Enabled = false },
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false }
            },
            Stroke = new Stroke { Curve = Curve.Stepline, Width = 2 },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels { Format = "HH:mm" },
                Tooltip = new XAxisTooltip { Enabled = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = $"function (value) {{ return value + '{unitSuffix}'; }}"
                    }
                }
            ],
            Tooltip = new Tooltip
            {
                X = new TooltipX { Format = "dd-MM-yyyy HH:mm" }
            }
        };
    }

}