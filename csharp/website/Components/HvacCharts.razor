@using shared
<RoomSelector RoomNames="_roomNames" OnActiveRoomsChanged="HandleActiveRoomsChanged"/>

<ApexChart TItem="ChartPoint" Title="Room temperatures [°C]" Options="_roomTemperaturesOptions"
           @ref="_chart1">
    @foreach (var roomName in _activeRoomNames)
    {
        <ApexPointSeries TItem="ChartPoint"
                         SeriesType="SeriesType.Line"
                         Name="@roomName"
                         Items="GetSimulationPoints(roomName)"
                         XValue="@(p => p.Timestamp)"
                         YValue="@(p => (decimal?)p.Temperature)"/>

        <ApexPointSeries TItem="ChartPoint"
                         SeriesType="SeriesType.Line"
                         Name="@($"{roomName} digital twin")"
                         Items="GetDigitalTwinPoints(roomName)"
                         XValue="@(p => p.Timestamp)"
                         YValue="@(p => (decimal?)p.Temperature)"/>

        @if (_activeRoomNames.Count != 1)
        {
            continue;
        }

        {
            <ApexPointSeries TItem="ChartPoint"
                             SeriesType="SeriesType.Line"
                             Name="@($"{roomName} min")"
                             Items="GetConfigPoints(roomName, ConfigLineType.Min)"
                             XValue="@(p => p.Timestamp)"
                             YValue="@(p => (decimal?)p.Temperature)"/>

            <ApexPointSeries TItem="ChartPoint"
                             SeriesType="SeriesType.Line"
                             Name="@($"{roomName} desired")"
                             Items="GetConfigPoints(roomName, ConfigLineType.Target)"
                             XValue="@(p => p.Timestamp)"
                             YValue="@(p => (decimal?)p.Temperature)"/>

            <ApexPointSeries TItem="ChartPoint"
                             SeriesType="SeriesType.Line"
                             Name="@($"{roomName} max")"
                             Items="GetConfigPoints(roomName, ConfigLineType.Max)"
                             XValue="@(p => p.Timestamp)"
                             YValue="@(p => (decimal?)p.Temperature)"/>
        }
    }
</ApexChart>

<ApexChart TItem="ChartPoint" Title="Room heatings/coolings [%]" Options="_roomHeatingsOptions"
           @ref="_chart2">
    @foreach (var roomName in _activeRoomNames)
    {
        <ApexPointSeries TItem="ChartPoint"
                         SeriesType="SeriesType.Line"
                         Name="@roomName"
                         Items="GetSimulationPoints(roomName)"
                         XValue="@(p => p.Timestamp)"
                         YValue="@(p => (decimal)p.Heating)"/>

        <ApexPointSeries TItem="ChartPoint"
                         SeriesType="SeriesType.Line"
                         Name="@($"{roomName} digital twin")"
                         Items="GetDigitalTwinPoints(roomName)"
                         XValue="@(p => p.Timestamp)"
                         YValue="@(p => (decimal)p.Heating)"/>
    }
</ApexChart>

<ApexChart TItem="ChartPoint" Title="Room CO₂ [ppm]" Options="_roomCo2Options"
           @ref="_chart3">
    @foreach (var roomName in _activeRoomNames)
    {
        <ApexPointSeries TItem="ChartPoint"
                         SeriesType="SeriesType.Line"
                         Name="@roomName"
                         Items="GetSimulationPoints(roomName)"
                         XValue="@(p => p.Timestamp)"
                         YValue="@(p => p.Co2)"/>

        <ApexPointSeries TItem="ChartPoint"
                         SeriesType="SeriesType.Line"
                         Name="@($"{roomName} digital twin")"
                         Items="GetDigitalTwinPoints(roomName)"
                         XValue="@(p => p.Timestamp)"
                         YValue="@(p => p.Co2)"/>
    }
</ApexChart>

<ApexChart TItem="ChartPoint" Title="Room ventilations [m³/h]" Options="_roomVentilationsOptions"
           @ref="_chart4">
    @foreach (var roomName in _activeRoomNames)
    {
        <ApexPointSeries TItem="ChartPoint"
                         SeriesType="SeriesType.Line"
                         Name="@roomName"
                         Items="GetSimulationPoints(roomName)"
                         XValue="@(p => p.Timestamp)"
                         YValue="@(p => (decimal)p.Ventilation)"/>

        <ApexPointSeries TItem="ChartPoint"
                         SeriesType="SeriesType.Line"
                         Name="@($"{roomName} digital twin")"
                         Items="GetDigitalTwinPoints(roomName)"
                         XValue="@(p => p.Timestamp)"
                         YValue="@(p => (decimal)p.Ventilation)"/>
    }
</ApexChart>

@if (_simulationTelemetry.Count != 0)
{
    <ApexChart TItem="Telemetry" Title="HVAC power [kW]" Options="_hvacPowerOptions"
               @ref="_chart5">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="HAVC power"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => Math.Abs((decimal)t.RoomHvacQ.Values.Sum()) / 1000)"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="HVAC power digital twin"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => Math.Abs((decimal)t.RoomHvacQ.Values.Sum()) / 1000)"/>
    </ApexChart>
}

@code {
    [Parameter] public List<AllApartmentsConfig>? ApartmentsConfig { get; set; }

    public class ChartPoint
    {
        public DateTimeOffset Timestamp { get; init; }
        public double? Temperature { get; init; }
        public int Co2 { get; init; }
        public double Heating { get; init; }
        public double Ventilation { get; init; }
    }

    public enum ConfigLineType
    {
        Min,
        Target,
        Max
    }

    private int _updateCounter;
    private List<Telemetry> _simulationTelemetry = [];
    private List<Telemetry> _digitalTwinTelemetry = [];
    private readonly List<string> _roomNames = [];
    private List<string> _activeRoomNames = [];

    private ApexChart<ChartPoint> _chart1 = new();
    private ApexChart<ChartPoint> _chart2 = new();
    private ApexChart<ChartPoint> _chart3 = new();
    private ApexChart<ChartPoint> _chart4 = new();
    private ApexChart<Telemetry> _chart5 = new();

    private ApexChartOptions<ChartPoint> _roomTemperaturesOptions = new();
    private ApexChartOptions<ChartPoint> _roomHeatingsOptions = new();
    private ApexChartOptions<ChartPoint> _roomCo2Options = new();
    private ApexChartOptions<ChartPoint> _roomVentilationsOptions = new();
    private ApexChartOptions<Telemetry> _hvacPowerOptions = new();

    private readonly string[] _basePalette =
    [
        "#008FFB", "#00E396", "#FEB019", "#FF4560", "#775DD0",
        "#3F51B5", "#546E7A", "#D4526E", "#8D5B4C", "#F86624", "#D7263D"
    ];

    protected override void OnInitialized()
    {
        _roomTemperaturesOptions = GenerateOptions<ChartPoint>("°C", min: 15.0, max: 27.0);
        _roomHeatingsOptions = GenerateOptions<ChartPoint>("%", min: -100.0, max: 100.0);
        _roomCo2Options = GenerateOptions<ChartPoint>("ppm", min: 350, max: 1050);
        _roomVentilationsOptions = GenerateOptions<ChartPoint>("m³/h");
        _hvacPowerOptions = GenerateOptions<Telemetry>("kW", 300);
    }

    public async Task AddSimulationTelemetryAsync(Telemetry msg)
    {
        _updateCounter++;

        _simulationTelemetry.Add(msg);

        if (_updateCounter % 5 == 0)
        {
            var cutoffTime = msg.Timestamp.AddHours(-24);

            _simulationTelemetry.RemoveAll(t => t.Timestamp < cutoffTime);
            _digitalTwinTelemetry.RemoveAll(t => t.Timestamp < cutoffTime);

            if (_roomNames.Count == 0)
            {
                _roomNames.AddRange(msg.RoomTemperatures.Keys);
            }
            else
            {
                ConfigureChartOptions();
                await _chart1.UpdateOptionsAsync(true, true, false);
                await _chart2.UpdateOptionsAsync(true, true, false);
                await _chart3.UpdateOptionsAsync(true, true, false);
                await _chart4.UpdateOptionsAsync(true, true, false);
            }

            if (_activeRoomNames.Count == 0)
            {
                _activeRoomNames = _roomNames.ToList();
                ConfigureChartOptions();
            }

            await Task.WhenAll(
                InvokeAsync(StateHasChanged),
                _chart1.UpdateSeriesAsync(),
                _chart2.UpdateSeriesAsync(),
                _chart3.UpdateSeriesAsync(),
                _chart4.UpdateSeriesAsync(),
                _chart5.UpdateSeriesAsync()
            );
        }
    }

    public async Task LoadSimulationTelemetryAsync(List<Telemetry> msgs)
    {
        _simulationTelemetry = msgs;

        _roomNames.Clear();
        var latest = _simulationTelemetry.LastOrDefault();
        if (latest?.RoomTemperatures != null)
        {
            _roomNames.AddRange(latest.RoomTemperatures.Keys);

            if (_activeRoomNames.Count == 0)
            {
                _activeRoomNames = _roomNames.ToList();
                ConfigureChartOptions();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    public async Task LoadDigitalTwinTelemetryAsync(List<Telemetry> msg)
    {
        _digitalTwinTelemetry = msg;

        ConfigureChartOptions();

        await _chart1.UpdateOptionsAsync(true, true, false);
        await _chart2.UpdateOptionsAsync(true, true, false);
        await _chart3.UpdateOptionsAsync(true, true, false);
        await _chart4.UpdateOptionsAsync(true, true, false);

        await Task.WhenAll(
            InvokeAsync(StateHasChanged),
            _chart1.UpdateSeriesAsync(),
            _chart2.UpdateSeriesAsync(),
            _chart3.UpdateSeriesAsync(),
            _chart4.UpdateSeriesAsync(),
            _chart5.UpdateSeriesAsync()
        );
    }

    private List<ChartPoint> GetSimulationPoints(string roomName)
    {
        return _simulationTelemetry.Select(t => new ChartPoint
        {
            Timestamp = t.Timestamp,
            Temperature = t.RoomTemperatures[roomName],
            Co2 = t.RoomCo2[roomName],
            Heating = t.RoomHeatings[roomName],
            Ventilation = t.RoomHvacV[roomName]
        }).ToList();
    }

    private List<ChartPoint> GetDigitalTwinPoints(string roomName)
    {
        return _digitalTwinTelemetry.Select(t => new ChartPoint
        {
            Timestamp = t.Timestamp,
            Temperature = t.RoomTemperatures[roomName],
            Co2 = t.RoomCo2[roomName],
            Heating = t.RoomHeatings[roomName],
            Ventilation = t.RoomHvacV[roomName]
        }).ToList();
    }

    private List<ChartPoint> GetConfigPoints(string roomName, ConfigLineType type)
    {
        var points = new List<ChartPoint>();

        if (ApartmentsConfig == null || !_simulationTelemetry.Any()) return points;

        var parts = roomName.Split(':');
        if (parts.Length < 3) return points;

        var bId = parts[0];
        var aId = parts[1];
        var rId = parts[2];

        var aptConfig = ApartmentsConfig.FirstOrDefault(a => a.BuildingId == bId && a.ApartmentId == aId);
        var roomConfig = aptConfig?.Rooms.FirstOrDefault(r => r.Id == rId);

        if (roomConfig == null || roomConfig.Hvac.Temperatures.Count == 0) return points;

        var minTimestamp = _digitalTwinTelemetry.Min(t => t.Timestamp);
        var maxTimestamp = _digitalTwinTelemetry.Max(t => t.Timestamp);

        var startMinute = minTimestamp.Minute - minTimestamp.Minute % 5;
        var currentTs = new DateTimeOffset(
            minTimestamp.Year, minTimestamp.Month, minTimestamp.Day,
            minTimestamp.Hour, startMinute, 0, minTimestamp.Offset);

        while (currentTs <= maxTimestamp)
        {
            var index = (currentTs.Hour * 60 + currentTs.Minute) / 5;

            if (index is >= 0 and < 288)
            {
                var val = type switch
                {
                    ConfigLineType.Min => roomConfig.Hvac.TemperaturesMin[index],
                    ConfigLineType.Target => roomConfig.Hvac.Temperatures[index],
                    ConfigLineType.Max => roomConfig.Hvac.TemperaturesMax[index],
                    _ => 21.0
                };

                points.Add(new ChartPoint { Timestamp = currentTs, Temperature = val });
            }

            currentTs = currentTs.AddMinutes(5);
        }

        return points;
    }

    private static ApexChartOptions<T> GenerateOptions<T>(string unitSuffix, int height = 450, double? min = null, double? max = null) where T : class
    {
        return new ApexChartOptions<T>
        {
            Chart = new Chart
            {
                Height = height,
                Type = ChartType.Line,
                Animations = new Animations { Enabled = false },
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false }
            },
            Stroke = new Stroke { Curve = Curve.Stepline, Width = 2 },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels { Format = "HH:mm" },
                Tooltip = new XAxisTooltip { Enabled = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Min = min,
                    Max = max,
                    Labels = new YAxisLabels
                    {
                        Formatter = $"function (value) {{ return value + '{unitSuffix}'; }}"
                    }
                }
            ],
            Tooltip = new Tooltip
            {
                X = new TooltipX { Format = "dd-MM-yyyy HH:mm" }
            }
        };
    }

    private void ConfigureChartOptions()
    {
        if (_activeRoomNames.Count == 0) return;

        var dashArray = new List<double>();
        var colors = new List<string>();

        for (var i = 0; i < _activeRoomNames.Count; i++)
        {
            var roomColor = _basePalette[i % _basePalette.Length];

            colors.Add(roomColor);
            dashArray.Add(0);

            colors.Add(roomColor);
            dashArray.Add(5);

            if (_activeRoomNames.Count > 1) continue;

            colors.Add("#FF4560");
            dashArray.Add(8);

            colors.Add("#00E396");
            dashArray.Add(0);

            colors.Add("#FF4560");
            dashArray.Add(8);
        }

        _roomTemperaturesOptions.Colors = colors;
        _roomHeatingsOptions.Colors = colors;
        _roomCo2Options.Colors = colors;
        _roomVentilationsOptions.Colors = colors;

        _roomTemperaturesOptions.Stroke ??= new Stroke();
        _roomHeatingsOptions.Stroke ??= new Stroke();
        _roomCo2Options.Stroke ??= new Stroke();
        _roomVentilationsOptions.Stroke ??= new Stroke();

        _roomTemperaturesOptions.Stroke.DashArray = dashArray;
        _roomHeatingsOptions.Stroke.DashArray = dashArray;
        _roomCo2Options.Stroke.DashArray = dashArray;
        _roomVentilationsOptions.Stroke.DashArray = dashArray;
    }

    private async Task HandleActiveRoomsChanged(List<string> filteredRooms)
    {
        _activeRoomNames = filteredRooms;

        ConfigureChartOptions();

        await InvokeAsync(StateHasChanged);

        var tasks = new List<Task>
        {
            UpdateChartSafelyAsync(_chart1),
            UpdateChartSafelyAsync(_chart2),
            UpdateChartSafelyAsync(_chart3),
            UpdateChartSafelyAsync(_chart4)
        };

        await Task.WhenAll(tasks);
    }

    private async Task UpdateChartSafelyAsync(ApexChart<ChartPoint> chart)
    {
        await chart.UpdateOptionsAsync(true, true, false);
        await chart.UpdateSeriesAsync();
    }

}