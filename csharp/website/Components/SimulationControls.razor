@using shared
<div class="my-10 border border-gray-700 rounded-xl overflow-hidden select-none">
    <div class="bg-gray-800 px-6 py-4 border-b border-gray-700 flex items-center justify-between">
        <p class="text-xl font-bold">Simulation Control Panel</p>

        <div class="flex items-center gap-6">
            <div class="text-xs flex items-center gap-2">
                <span>Connection:</span>
                <span class="font-bold @(IsConnected ? "text-green-500" : "text-red-500")">
                    @ConnectionStatus.ToUpper()
                </span>
            </div>

            <div class="text-xs flex items-center gap-2">
                <span>Simulation timestamp:</span>
                <span class="font-bold @(IsConnected ? "text-green-500" : "text-red-500")">
                    @(SimulationTimestamp.ToString("dd-MM-yyyy HH:mm zzz"))
                </span>
            </div>

            <div class="text-xs flex items-center gap-2">
                <span>Digital Twin timestamp:</span>
                <span class="font-bold @(IsConnected ? "text-green-500" : "text-red-500")">
                    @(DigitalTwinTimestamp.ToString("dd-MM-yyyy HH:mm zzz"))
                </span>
            </div>
        </div>
    </div>

    <div class="p-2">
        @if (Config == null)
        {
            <div class="text-center py-12 animate-pulse flex flex-col items-center gap-2">
                <span>Waiting for configuration data...</span>
            </div>
        }
        else
        {
            <table class="w-full text-left">
                <tbody>
                <tr class="border-b border-gray-700">
                    <td class="py-4 px-2 font-medium w-1/4 uppercase text-xs">Control</td>
                    <td class="py-4 px-2">
                        <div class="flex gap-4">
                            @if (Config.IsPaused == true)
                            {
                                <button @onclick="OnResume"
                                        class="bg-green-700 hover:bg-green-600 font-medium px-6 py-2 rounded-md shadow transition-all border border-green-600 hover:border-green-500">
                                    Resume
                                </button>
                            }
                            else
                            {
                                <button @onclick="OnPause"
                                        class="bg-amber-700 hover:bg-amber-600 font-medium px-6 py-2 rounded-md shadow transition-all border border-amber-600 hover:border-amber-500">
                                    Pause
                                </button>
                            }
                            <button @onclick="OnReset"
                                    class="bg-red-700 hover:bg-red-600 font-medium px-6 py-2 rounded-md shadow transition-all border border-red-600 hover:border-red-500">
                                Reset
                            </button>
                        </div>
                    </td>
                </tr>

                <tr class="border-b border-gray-700">
                    <td class="py-4 px-2 font-medium uppercase text-xs">Simulation speed</td>
                    <td class="py-4 px-2">
                        <div class="flex flex-wrap gap-2">
                            @foreach (var speedValue in new[] { 5, 10, 30, 60, 300, 600 })
                            {
                                var isActive = Config.SimulationSpeed == speedValue;

                                <button @onclick="() => OnSpeedChange.InvokeAsync(speedValue)"
                                        class="px-4 py-2 rounded-md text-xs font-bold transition-all border @(isActive ? "bg-indigo-700 border-indigo-600" : "bg-gray-800 border-gray-700 hover:bg-gray-700 hover:border-gray-600")">
                                    x@(speedValue)
                                </button>
                            }
                        </div>
                    </td>
                </tr>

                <tr class="border-b border-gray-700">
                    <td class="py-5 px-2 font-medium uppercase text-xs">Simulation step</td>
                    <td class="py-5 px-2">
                        <div class="flex flex-wrap gap-2">
                            @foreach (var stepValue in new[] { 300, 600, 900, 1800, 3600 })
                            {
                                var isActive = Config.SimulationStep == stepValue;
                                var label = stepValue >= 60 ? $"{stepValue / 60}m" : $"{stepValue}s";

                                <button @onclick="() => OnStepChange.InvokeAsync(stepValue)"
                                        class="px-4 py-2 rounded-md text-xs font-bold transition-all border @(isActive ? "bg-indigo-700 border-indigo-600" : "bg-gray-800 border-gray-700 hover:bg-gray-700 hover:border-gray-600")">
                                    @label
                                </button>
                            }
                        </div>
                    </td>
                </tr>

                <tr>
                    <td class="py-5 px-2 font-medium uppercase text-xs">Room temperature noise factor</td>
                    <td class="py-5 px-2">
                        <div class="flex flex-wrap gap-2">
                            @foreach (var sigmaValue in new[] { 0.0, 0.1, 0.2, 0.5 })
                            {
                                var isActive = Config.RoomTemperatureNoiseSigma is { } sigma &&
                                                   Math.Abs(sigma - sigmaValue) < 0.001;

                                <button @onclick="() => OnSigmaChange.InvokeAsync(sigmaValue)"
                                        class="px-4 py-2 rounded-md text-xs font-bold transition-all border @(isActive ? "bg-indigo-700 border-indigo-600" : "bg-gray-800 border-gray-700 hover:bg-gray-700 hover:border-gray-600")">
                                    @sigmaValue
                                </button>
                            }
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsConnected { get; set; }
    [Parameter] public string ConnectionStatus { get; set; } = "Disconnected";
    [Parameter] public DateTimeOffset SimulationTimestamp { get; set; }
    [Parameter] public DateTimeOffset DigitalTwinTimestamp { get; set; }
    [Parameter] public Config? Config { get; set; }

    [Parameter] public EventCallback OnResume { get; set; }
    [Parameter] public EventCallback OnPause { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback<int> OnSpeedChange { get; set; }
    [Parameter] public EventCallback<int> OnStepChange { get; set; }
    [Parameter] public EventCallback<double> OnSigmaChange { get; set; }
}