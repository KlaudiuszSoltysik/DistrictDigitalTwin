@using shared
<ApexChart TItem="Telemetry" Title="Temperature [°C]" Options="_temperatureChartOptions" @ref="_chart1">
    <ApexPointSeries TItem="Telemetry"
                     SeriesType="SeriesType.Line"
                     Name="Temperature"
                     Items="_simulationTelemetry"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.Temperature)"/>

    <ApexPointSeries TItem="Telemetry"
                     SeriesType="SeriesType.Line"
                     Name="Temperature forecast"
                     Items="_digitalTwinTelemetry"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.Temperature)"/>
</ApexChart>

<ApexChart TItem="Telemetry" Title="Wind speed [km/h]" Options="_windSpeedChartOptions" @ref="_chart2">
    <ApexPointSeries TItem="Telemetry"
                     SeriesType="SeriesType.Line"
                     Name="Wind speed"
                     Items="_simulationTelemetry"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.WindSpeed)"/>

    <ApexPointSeries TItem="Telemetry"
                     SeriesType="SeriesType.Line"
                     Name="Wind speed forecast"
                     Items="_digitalTwinTelemetry"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.WindSpeed)"/>
</ApexChart>

<ApexChart TItem="Telemetry" Title="Sun radiation [W/m²]" Options="_sunRadiationChartOptions"
           @ref="_chart3">
    <ApexPointSeries TItem="Telemetry"
                     SeriesType="SeriesType.Line"
                     Name="Sun radiation"
                     Items="_simulationTelemetry"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.SunRadiation)"/>

    <ApexPointSeries TItem="Telemetry"
                     SeriesType="SeriesType.Line"
                     Name="Sun radiation forecast"
                     Items="_digitalTwinTelemetry"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.SunRadiation)"/>
</ApexChart>

<ApexChart TItem="Telemetry" Title="Sun altitude [°]" Options="_sunAltitudeChartOptions" @ref="_chart4">
    <ApexPointSeries TItem="Telemetry"
                     SeriesType="SeriesType.Line"
                     Name="Sun altitude"
                     Items="_simulationTelemetry"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.SunAltitude)"/>

    <ApexPointSeries TItem="Telemetry"
                     SeriesType="SeriesType.Line"
                     Name="Sun altitude forecast"
                     Items="_digitalTwinTelemetry"
                     XValue="@(t => t.Timestamp)"
                     YValue="@(t => (decimal?)t.Weather.SunAltitude)"/>
</ApexChart>

<div class="p-6 flex flex-wrap gap-6 items-end">
    <div class="flex flex-col gap-2 w-full sm:w-48">
        <label class="font-medium uppercase text-xs text-gray-400">Building</label>
        <select @bind="_selectedBuilding" @bind:after="OnBuildingChangedAsync"
                class="bg-gray-800 border border-gray-700 text-sm font-medium rounded-md px-3 py-2.5 shadow-sm transition-all outline-none hover:bg-gray-700 hover:border-gray-600 focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600">
            <option value="All">All</option>
            @foreach (var opt in GetBuildingOptions())
            {
                <option value="@opt">@opt</option>
            }
        </select>
    </div>

    <div class="flex flex-col gap-2 w-full sm:w-48">
        <label class="font-medium uppercase text-xs text-gray-400">Apartment</label>
        <select @bind="_selectedApartment" @bind:after="OnApartmentChangedAsync"
                disabled="@(_selectedBuilding == "All")"
                class="bg-gray-800 border border-gray-700 text-sm font-medium rounded-md px-3 py-2.5 shadow-sm transition-all outline-none hover:bg-gray-700 hover:border-gray-600 focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-gray-800 disabled:hover:border-gray-700">
            <option value="All">All</option>
            @foreach (var opt in GetApartmentOptions())
            {
                <option value="@opt">@opt</option>
            }
        </select>
    </div>

    <div class="flex flex-col gap-2 w-full sm:w-48">
        <label class="font-medium uppercase text-xs text-gray-400">Room</label>
        <select @bind="_selectedRoom" @bind:after="OnRoomChangedAsync" disabled="@(_selectedApartment == "All")"
                class="bg-gray-800 border border-gray-700 text-sm font-medium rounded-md px-3 py-2.5 shadow-sm transition-all outline-none hover:bg-gray-700 hover:border-gray-600 focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-gray-800 disabled:hover:border-gray-700">
            <option value="All">All</option>
            @foreach (var opt in GetRoomOptions())
            {
                <option value="@opt">@opt</option>
            }
        </select>
    </div>
</div>

<ApexChart TItem="Telemetry" Title="Room temperatures [°C]" Options="_roomTemperaturesOptions"
           @ref="_chart5">
    @foreach (var roomName in _activeRoomNames)
    {
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="@roomName"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => GetRoomTemperature(t, roomName))"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="@($"{roomName} digital twin")"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => GetRoomTemperature(t, roomName))"/>
    }
</ApexChart>

@code {
    private int _updateCounter;
    private List<Telemetry> _simulationTelemetry = [];
    private List<Telemetry> _digitalTwinTelemetry = [];
    private readonly List<string> _roomNames = [];

    private ApexChart<Telemetry> _chart1 = new();
    private ApexChart<Telemetry> _chart2 = new();
    private ApexChart<Telemetry> _chart3 = new();
    private ApexChart<Telemetry> _chart4 = new();
    private ApexChart<Telemetry> _chart5 = new();

    private ApexChartOptions<Telemetry> _temperatureChartOptions = new();
    private ApexChartOptions<Telemetry> _windSpeedChartOptions = new();
    private ApexChartOptions<Telemetry> _sunRadiationChartOptions = new();
    private ApexChartOptions<Telemetry> _sunAltitudeChartOptions = new();
    private ApexChartOptions<Telemetry> _roomTemperaturesOptions = new();

    private readonly string[] _basePalette =
    [
        "#008FFB", "#00E396", "#FEB019", "#FF4560", "#775DD0",
        "#3F51B5", "#546E7A", "#D4526E", "#8D5B4C", "#F86624", "#D7263D"
    ];

    private string _selectedBuilding = "All";
    private string _selectedApartment = "All";
    private string _selectedRoom = "All";

    private List<string> _activeRoomNames = [];

    protected override void OnInitialized()
    {
        _temperatureChartOptions = GenerateOptions("°C");
        _windSpeedChartOptions = GenerateOptions(" km/h");
        _sunRadiationChartOptions = GenerateOptions(" W/m²");
        _sunAltitudeChartOptions = GenerateOptions("°");
        _roomTemperaturesOptions = GenerateOptions("°C", 600);
    }

    public async Task AddSimulationTelemetryAsync(Telemetry msg)
    {
        _updateCounter++;

        _simulationTelemetry.Add(msg);

        if (_updateCounter % 5 == 0)
        {
            var cutoffTime = msg.Timestamp.AddHours(-24);

            _simulationTelemetry.RemoveAll(t => t.Timestamp < cutoffTime);
            _digitalTwinTelemetry.RemoveAll(t => t.Timestamp < cutoffTime);

            if (_roomNames.Count == 0)
            {
                _roomNames.AddRange(msg.RoomTemperatures.Keys);

                await ApplyFiltersAndUpdateChartAsync();
            }
            else
            {
                ConfigureChartOptions();
                await _chart5.UpdateOptionsAsync(true, true, false);
            }

            await Task.WhenAll(
                InvokeAsync(StateHasChanged),
                _chart1.UpdateSeriesAsync(),
                _chart2.UpdateSeriesAsync(),
                _chart3.UpdateSeriesAsync(),
                _chart4.UpdateSeriesAsync(),
                _chart5.UpdateSeriesAsync()
            );
        }
    }

    public async Task LoadSimulationTelemetryAsync(List<Telemetry> msgs)
    {
        _simulationTelemetry = msgs;

        _roomNames.Clear();
        var latest = _simulationTelemetry.LastOrDefault();
        if (latest?.RoomTemperatures != null)
        {
            _roomNames.AddRange(latest.RoomTemperatures.Keys);
        }

        await ApplyFiltersAndUpdateChartAsync();

        await InvokeAsync(StateHasChanged);
    }

    public async Task LoadDigitalTwinTelemetryAsync(List<Telemetry> msg)
    {
        _digitalTwinTelemetry = msg;

        ConfigureChartOptions();

        await _chart5.UpdateOptionsAsync(true, true, false);

        await Task.WhenAll(
            InvokeAsync(StateHasChanged),
            _chart1.UpdateSeriesAsync(),
            _chart2.UpdateSeriesAsync(),
            _chart3.UpdateSeriesAsync(),
            _chart4.UpdateSeriesAsync(),
            _chart5.UpdateSeriesAsync()
        );
    }

    public async Task ClearChartsAsync()
    {
        _simulationTelemetry.Clear();
        _digitalTwinTelemetry.Clear();

        await Task.WhenAll(
            _chart1.UpdateSeriesAsync(),
            _chart2.UpdateSeriesAsync(),
            _chart3.UpdateSeriesAsync(),
            _chart4.UpdateSeriesAsync(),
            _chart5.UpdateSeriesAsync()
        );

        await InvokeAsync(StateHasChanged);
    }

    private static ApexChartOptions<Telemetry> GenerateOptions(string unitSuffix, int height = 300)
    {
        return new ApexChartOptions<Telemetry>
        {
            Chart = new Chart
            {
                Height = height,
                Type = ChartType.Line,
                Animations = new Animations { Enabled = false },
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false }
            },
            Stroke = new Stroke { Curve = Curve.Stepline, Width = 2 },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels { Format = "HH:mm" },
                Tooltip = new XAxisTooltip { Enabled = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = $"function (value) {{ return value + '{unitSuffix}'; }}"
                    }
                }
            ],
            Tooltip = new Tooltip
            {
                X = new TooltipX { Format = "dd-MM-yyyy HH:mm" }
            }
        };
    }

    private static decimal? GetRoomTemperature(Telemetry item, string roomName)
    {
        if (item.RoomTemperatures.TryGetValue(roomName, out var temp))
        {
            return (decimal)temp;
        }

        return null;
    }

    private void ConfigureChartOptions()
    {
        if (_activeRoomNames.Count == 0) return;

        var dashArray = new List<double>();
        var colors = new List<string>();

        for (var i = 0; i < _activeRoomNames.Count; i++)
        {
            var roomColor = _basePalette[i % _basePalette.Length];

            colors.Add(roomColor);
            colors.Add(roomColor);

            dashArray.Add(0);
            dashArray.Add(5);
        }

        _roomTemperaturesOptions.Colors = colors;

        _roomTemperaturesOptions.Stroke?.DashArray = dashArray;
    }

    private IEnumerable<string> GetBuildingOptions()
    {
        return _roomNames.Select(k => k.Split(':')[0]).Distinct();
    }

    private IEnumerable<string> GetApartmentOptions()
    {
        return _selectedBuilding == "All"
            ? []
            : _roomNames.Where(k => k.StartsWith($"{_selectedBuilding}:"))
                .Select(k => k.Split(':')[1]).Distinct();
    }

    private IEnumerable<string> GetRoomOptions()
    {
        return _selectedApartment == "All"
            ? []
            : _roomNames.Where(k => k.StartsWith($"{_selectedBuilding}:{_selectedApartment}:"))
                .Select(k => k.Split(':')[2]).Distinct();
    }

    private async Task OnBuildingChangedAsync()
    {
        _selectedApartment = "All";
        _selectedRoom = "All";
        await ApplyFiltersAndUpdateChartAsync();
    }

    private async Task OnApartmentChangedAsync()
    {
        _selectedRoom = "All";
        await ApplyFiltersAndUpdateChartAsync();
    }

    private async Task OnRoomChangedAsync()
    {
        await ApplyFiltersAndUpdateChartAsync();
    }

    private async Task ApplyFiltersAndUpdateChartAsync()
    {
        _activeRoomNames = _roomNames.Where(key =>
        {
            var parts = key.Split(':');
            if (parts.Length < 3) return false;

            var match1 = _selectedBuilding == "All" || parts[0] == _selectedBuilding;
            var match2 = _selectedApartment == "All" || parts[1] == _selectedApartment;
            var match3 = _selectedRoom == "All" || parts[2] == _selectedRoom;

            return match1 && match2 && match3;
        }).ToList();

        ConfigureChartOptions();

        await _chart5.UpdateOptionsAsync(true, true, false);
        await _chart5.UpdateSeriesAsync();
    }

}