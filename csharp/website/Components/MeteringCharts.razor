@using shared
@if (_previousMonthData.Count > 0)
{
    <h4 class="mt-4 text-xl">Previous month</h4>
    <div class="row">
        <div class="col-md-6">
            <ApexChart TItem="DataPoint" Title="Electricity import (Total) [kWh]"
                       Options="_previousElectricityImportSumChartOptions" @ref="_chart1">
                <ApexPointSeries TItem="DataPoint"
                                 SeriesType="SeriesType.Area"
                                 Name="Total import"
                                 Items="_previousMonthData"
                                 XValue="@(t => t.Timestamp)"
                                 YValue="@(t => t.ElectricityImportSum - _previousMonthData[0].ElectricityImportSum)"/>
            </ApexChart>
        </div>

        <div class="col-md-6">
            <ApexChart TItem="DataPoint" Title="Electricity import (Step) [kWh]"
                       Options="_previousElectricityImportDeltaChartOptions" @ref="_chart2">
                <ApexPointSeries TItem="DataPoint"
                                 SeriesType="SeriesType.Area"
                                 Name="Step import"
                                 Items="_previousMonthData"
                                 XValue="@(t => t.Timestamp)"
                                 YValue="@(t => t.ElectricityImportDelta)"/>
            </ApexChart>
        </div>
    </div>
}

@if (_currentMonthData.Count > 0)
{
    <h4 class="mt-4 text-xl">Current month</h4>
    <div class="row">
        <div class="col-md-6">
            <ApexChart TItem="DataPoint" Title="Electricity import (Total) [kWh]"
                       Options="_currentElectricityImportSumChartOptions" @ref="_chart3">
                <ApexPointSeries TItem="DataPoint"
                                 SeriesType="SeriesType.Area"
                                 Name="Total import"
                                 Items="_currentMonthData"
                                 XValue="@(t => t.Timestamp)"
                                 YValue="@(t => t.ElectricityImportSum - _currentMonthData[0].ElectricityImportSum)"/>
            </ApexChart>
        </div>

        <div class="col-md-6">
            <ApexChart TItem="DataPoint" Title="Electricity import (Step) [kWh]"
                       Options="_currentElectricityImportDeltaChartOptionsC" @ref="_chart4">
                <ApexPointSeries TItem="DataPoint"
                                 SeriesType="SeriesType.Area"
                                 Name="Step import"
                                 Items="_currentMonthData"
                                 XValue="@(t => t.Timestamp)"
                                 YValue="@(t => t.ElectricityImportDelta)"/>
            </ApexChart>
        </div>
    </div>
}

@code {

    public class DataPoint
    {
        public DateTimeOffset Timestamp { get; set; }
        public decimal ElectricityImportSum { get; set; }
        public decimal ElectricityImportDelta { get; set; }
    }

    private int _updateCounter;

    private List<DataPoint> _fullData = [];
    private List<DataPoint> _previousMonthData = [];
    private List<DataPoint> _currentMonthData = [];

    private ApexChart<DataPoint>? _chart1;
    private ApexChart<DataPoint>? _chart2;
    private ApexChart<DataPoint>? _chart3;
    private ApexChart<DataPoint>? _chart4;

    private ApexChartOptions<DataPoint> _previousElectricityImportSumChartOptions = new();
    private ApexChartOptions<DataPoint> _previousElectricityImportDeltaChartOptions = new();
    private ApexChartOptions<DataPoint> _currentElectricityImportSumChartOptions = new();
    private ApexChartOptions<DataPoint> _currentElectricityImportDeltaChartOptionsC = new();

    protected override void OnInitialized()
    {
        _previousElectricityImportSumChartOptions = GenerateOptions(" kWh");
        _previousElectricityImportDeltaChartOptions = GenerateOptions(" kWh");

        _currentElectricityImportSumChartOptions = GenerateOptions(" kWh");
        _currentElectricityImportDeltaChartOptionsC = GenerateOptions(" kWh");
    }

    public async Task AddSimulationTelemetryAsync(Telemetry msg)
    {
        _updateCounter++;

        var newDataPoint = new DataPoint
        {
            Timestamp = msg.Timestamp,
            ElectricityImportSum = (decimal)msg.Metering.AdminMeters["electricity_import"],
            ElectricityImportDelta = _fullData.Count == 0 ? (decimal)msg.Metering.AdminMeters["electricity_import"] : (decimal)msg.Metering.AdminMeters["electricity_import"] - _fullData[^1].ElectricityImportSum
        };

        _fullData.Add(newDataPoint);

        var latestTimestamp = _fullData[^1].Timestamp;
        var prevMonthDate = latestTimestamp.AddMonths(-1);
        var cutoff = new DateTimeOffset(prevMonthDate.Year, prevMonthDate.Month, 1, 0, 0, 0, latestTimestamp.Offset);

        _fullData.RemoveAll(d => d.Timestamp < cutoff);

        if (_updateCounter % 5 == 0)
        {
            var firstTimestamp = _fullData[0].Timestamp;
            var lastTimestamp = _fullData[^1].Timestamp;

            if (firstTimestamp.Month == lastTimestamp.Month)
            {
                _currentMonthData = _fullData;

                await InvokeAsync(StateHasChanged);
            }
            else
            {
                _previousMonthData = _fullData.Where(m => m.Timestamp.Month == firstTimestamp.Month).ToList();
                _currentMonthData = _fullData.Where(m => m.Timestamp.Month == lastTimestamp.Month).ToList();

                await InvokeAsync(StateHasChanged);

                if (_chart1 != null) await _chart1.UpdateSeriesAsync();
                if (_chart2 != null) await _chart2.UpdateSeriesAsync();
            }

            if (_chart3 != null) await _chart3.UpdateSeriesAsync();
            if (_chart4 != null) await _chart4.UpdateSeriesAsync();
        }
    }

    public async Task LoadSimulationTelemetryAsync(List<Telemetry> msgs)
    {
        _fullData = msgs.Select((m, i) => new DataPoint
        {
            Timestamp = m.Timestamp,
            ElectricityImportSum = (decimal)m.Metering.AdminMeters["electricity_import"],
            ElectricityImportDelta = i == 0 ?
                (decimal)m.Metering.AdminMeters["electricity_import"] :
                (decimal)(m.Metering.AdminMeters["electricity_import"] - msgs[i - 1].Metering.AdminMeters["electricity_import"])
        }).ToList();

        var firstTimestamp = _fullData[0].Timestamp;
        var lastTimestamp = _fullData[^1].Timestamp;

        if (firstTimestamp.Month == lastTimestamp.Month)
        {
            _currentMonthData = _fullData;
        }
        else
        {
            _previousMonthData = _fullData.Where(m => m.Timestamp.Month == firstTimestamp.Month).ToList();
            _currentMonthData = _fullData.Where(m => m.Timestamp.Month == lastTimestamp.Month).ToList();
        }

        await InvokeAsync(StateHasChanged);
    }

    private static ApexChartOptions<DataPoint> GenerateOptions(string unitSuffix)
    {
        return new ApexChartOptions<DataPoint>
        {
            Chart = new Chart
            {
                Height = 400,
                Type = ChartType.Area,
                Animations = new Animations { Enabled = false },
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false }
            },
            Stroke = new Stroke { Curve = Curve.Stepline, Width = 2 },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels { Format = "dd-MM HH:mm" },
                Tooltip = new XAxisTooltip { Enabled = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Min = 0,
                    Labels = new YAxisLabels
                    {
                        Formatter = $"function (value) {{ return value.toFixed(2) + '{unitSuffix}'; }}"
                    }
                }
            ],
            Tooltip = new Tooltip
            {
                X = new TooltipX { Format = "dd-MM-yyyy HH:mm" }
            }
        };
    }

}