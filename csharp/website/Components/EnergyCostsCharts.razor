@using shared
@if (_simulationTelemetry.Count != 0)
{
    <ApexChart TItem="Telemetry" Title="Electricity cost [EUR/MWh]" Options="_electricityCostChartOptions"
               @ref="_chart1">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Electricity price"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.EnergyCosts.ElectricityCost)"/>
    </ApexChart>

    <ApexChart TItem="Telemetry" Title="Gas cost [EUR/MWh]" Options="_gasCostChartOptions" @ref="_chart2">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Gas price"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.EnergyCosts.GasCost)"/>
    </ApexChart>

    <ApexChart TItem="Telemetry" Title="PV farm yield [kW]" Options="_pvFarmYieldChartOptions" @ref="_chart3">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="PV farm power"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.EnergyCosts.PvFarmYield)"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="PV farm power forecast"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.EnergyCosts.PvFarmYield)"/>
    </ApexChart>

    <ApexChart TItem="Telemetry" Title="COP heating" Options="_copHeatingChartOptions" @ref="_chart4">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Heat pump heating coefficient"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.EnergyCosts.CopHeating)"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Heat pump heating coefficient forecast"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.EnergyCosts.CopHeating)"/>
    </ApexChart>

    <ApexChart TItem="Telemetry" Title="COP cooling" Options="_copCoolingChartOptions" @ref="_chart5">
        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Heat pump cooling coefficient"
                         Items="_simulationTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.EnergyCosts.CopCooling)"/>

        <ApexPointSeries TItem="Telemetry"
                         SeriesType="SeriesType.Line"
                         Name="Heat pump cooling coefficient forecast"
                         Items="_digitalTwinTelemetry"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.EnergyCosts.CopCooling)"/>
    </ApexChart>
}



@code {
    private int _updateCounter;
    private List<Telemetry> _simulationTelemetry = [];
    private List<Telemetry> _digitalTwinTelemetry = [];

    private ApexChart<Telemetry> _chart1 = new();
    private ApexChart<Telemetry> _chart2 = new();
    private ApexChart<Telemetry> _chart3 = new();
    private ApexChart<Telemetry> _chart4 = new();
    private ApexChart<Telemetry> _chart5 = new();

    private ApexChartOptions<Telemetry> _electricityCostChartOptions = new();
    private ApexChartOptions<Telemetry> _gasCostChartOptions = new();
    private ApexChartOptions<Telemetry> _pvFarmYieldChartOptions = new();
    private ApexChartOptions<Telemetry> _copHeatingChartOptions = new();
    private ApexChartOptions<Telemetry> _copCoolingChartOptions = new();


    protected override void OnInitialized()
    {
        _electricityCostChartOptions = GenerateOptions(" EUR/MWh");
        _gasCostChartOptions = GenerateOptions(" EUR/MWh");
        _pvFarmYieldChartOptions = GenerateOptions(" kW");
        _copHeatingChartOptions = GenerateOptions("");
        _copCoolingChartOptions = GenerateOptions("");
    }

    public async Task AddSimulationTelemetryAsync(Telemetry msg)
    {
        _updateCounter++;

        _simulationTelemetry.Add(msg);

        if (_updateCounter % 5 == 0)
        {
            var cutoffTime = msg.Timestamp.AddHours(-24);

            _simulationTelemetry.RemoveAll(t => t.Timestamp < cutoffTime);
            _digitalTwinTelemetry.RemoveAll(t => t.Timestamp < cutoffTime);

            await Task.WhenAll(
                InvokeAsync(StateHasChanged),
                _chart1.UpdateSeriesAsync(),
                _chart2.UpdateSeriesAsync(),
                _chart3.UpdateSeriesAsync(),
                _chart4.UpdateSeriesAsync(),
                _chart5.UpdateSeriesAsync()
            );
        }
    }

    public async Task LoadSimulationTelemetryAsync(List<Telemetry> msgs)
    {
        _simulationTelemetry = msgs;

        await InvokeAsync(StateHasChanged);
    }

    public async Task LoadDigitalTwinTelemetryAsync(List<Telemetry> msg)
    {
        _digitalTwinTelemetry = msg;

        await Task.WhenAll(
            InvokeAsync(StateHasChanged),
            _chart1.UpdateSeriesAsync(),
            _chart2.UpdateSeriesAsync(),
            _chart3.UpdateSeriesAsync(),
            _chart4.UpdateSeriesAsync(),
            _chart5.UpdateSeriesAsync()
        );
    }

    private static ApexChartOptions<Telemetry> GenerateOptions(string unitSuffix)
    {
        return new ApexChartOptions<Telemetry>
        {
            Chart = new Chart
            {
                Height = 300,
                Type = ChartType.Line,
                Animations = new Animations { Enabled = false },
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false }
            },
            Stroke = new Stroke { Curve = Curve.Stepline, Width = 2 },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels { Format = "HH:mm" },
                Tooltip = new XAxisTooltip { Enabled = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = $"function (value) {{ return value + '{unitSuffix}'; }}"
                    }
                }
            ],
            Tooltip = new Tooltip
            {
                X = new TooltipX { Format = "dd-MM-yyyy HH:mm" }
            }
        };
    }

}