@using shared
@if (_telemetryHistory.Count != 0)
{
    <ApexChart TItem="SimulationTelemetry" Title="Temperature [°C]" Options="_temperatureChartOptions" @ref="_chart1">
        <ApexPointSeries TItem="SimulationTelemetry"
                         SeriesType="SeriesType.Line"
                         Name="Temperature"
                         Items="_telemetryHistory"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.Temperature)"/>
    </ApexChart>

    <ApexChart TItem="SimulationTelemetry" Title="Wind speed [km/h]" Options="_windSpeedChartOptions" @ref="_chart2">
        <ApexPointSeries TItem="SimulationTelemetry"
                         SeriesType="SeriesType.Line"
                         Name="Wind speed"
                         Items="_telemetryHistory"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.WindSpeed)"/>
    </ApexChart>

    <ApexChart TItem="SimulationTelemetry" Title="Sun radiation [W/m²]" Options="_sunRadiationChartOptions"
               @ref="_chart3">
        <ApexPointSeries TItem="SimulationTelemetry"
                         SeriesType="SeriesType.Line"
                         Name="Sun radiation"
                         Items="_telemetryHistory"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.SunRadiation)"/>
    </ApexChart>

    <ApexChart TItem="SimulationTelemetry" Title="Sun altitude [°]" Options="_sunAltitudeChartOptions" @ref="_chart4">
        <ApexPointSeries TItem="SimulationTelemetry"
                         SeriesType="SeriesType.Line"
                         Name="Sun altitude"
                         Items="_telemetryHistory"
                         XValue="@(t => t.Timestamp)"
                         YValue="@(t => (decimal?)t.Weather.SunAltitude)"/>
    </ApexChart>

    <ApexChart TItem="SimulationTelemetry" Title="Room temperatures [°C]" Options="_roomTemperaturesOptions"
               @ref="_chart5">
        @foreach (var roomName in _roomNames)
        {
            <ApexPointSeries TItem="SimulationTelemetry"
                             SeriesType="SeriesType.Line"
                             Name="@roomName"
                             Items="_telemetryHistory"
                             XValue="@(t => t.Timestamp)"
                             YValue="@(t => GetRoomTemperature(t, roomName))"/>
        }
    </ApexChart>
}

@code {
    private int _updateCounter;
    private List<SimulationTelemetry> _telemetryHistory = [];
    private readonly List<string> _roomNames = [];

    private ApexChart<SimulationTelemetry> _chart1 = new();
    private ApexChart<SimulationTelemetry> _chart2 = new();
    private ApexChart<SimulationTelemetry> _chart3 = new();
    private ApexChart<SimulationTelemetry> _chart4 = new();
    private ApexChart<SimulationTelemetry> _chart5 = new();

    private ApexChartOptions<SimulationTelemetry> _temperatureChartOptions = new();
    private ApexChartOptions<SimulationTelemetry> _windSpeedChartOptions = new();
    private ApexChartOptions<SimulationTelemetry> _sunRadiationChartOptions = new();
    private ApexChartOptions<SimulationTelemetry> _sunAltitudeChartOptions = new();
    private ApexChartOptions<SimulationTelemetry> _roomTemperaturesOptions = new();

    protected override void OnInitialized()
    {
        _temperatureChartOptions = GenerateOptions("°C");
        _windSpeedChartOptions = GenerateOptions(" km/h");
        _sunRadiationChartOptions = GenerateOptions(" W/m²");
        _sunAltitudeChartOptions = GenerateOptions("°");
        _roomTemperaturesOptions = GenerateOptions("°C");
    }

    public async Task AddTelemetryAsync(SimulationTelemetry msg)
    {
        try
        {
            _updateCounter++;

            _telemetryHistory.Add(msg);

            if (_updateCounter % 5 == 0)
            {
                var cutoffTime = msg.Timestamp.AddHours(-24);

                while (_telemetryHistory.Count > 0 && _telemetryHistory[0].Timestamp < cutoffTime)
                {
                    _telemetryHistory.RemoveAt(0);
                }

                foreach (var key in msg.RoomTemperatures.Keys)
                {
                    _roomNames.Add(key);
                }

                await Task.WhenAll(
                    _chart1.UpdateSeriesAsync(),
                    _chart2.UpdateSeriesAsync(),
                    _chart3.UpdateSeriesAsync(),
                    _chart4.UpdateSeriesAsync(),
                    _chart5.UpdateSeriesAsync()
                );
            }
        }
        catch
        {
            // ignored
        }
    }

    public async Task LoadHistoryAsync(List<SimulationTelemetry> history)
    {
        _telemetryHistory = history.ToList();

        _roomNames.Clear();
        var latest = _telemetryHistory.LastOrDefault();
        if (latest?.RoomTemperatures != null)
        {
            _roomNames.AddRange(latest.RoomTemperatures.Keys);
        }

        await InvokeAsync(StateHasChanged);
    }

    public async Task ClearChartsAsync()
    {
        _telemetryHistory.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private static ApexChartOptions<SimulationTelemetry> GenerateOptions(string unitSuffix)
    {
        return new ApexChartOptions<SimulationTelemetry>
        {
            Chart = new Chart
            {
                Height = 300,
                Type = ChartType.Line,
                Animations = new Animations { Enabled = false },
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false }
            },
            Stroke = new Stroke { Curve = Curve.Stepline, Width = 2 },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels { Format = "HH:mm" },
                Tooltip = new XAxisTooltip { Enabled = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = $"function (value) {{ return value.toFixed(0) + '{unitSuffix}'; }}"
                    }
                }
            ],
            Tooltip = new Tooltip
            {
                X = new TooltipX { Format = "dd-MM-yyyy HH:mm" }
            }
        };
    }

    private static decimal? GetRoomTemperature(SimulationTelemetry item, string roomName)
    {
        if (item.RoomTemperatures.TryGetValue(roomName, out var temp))
        {
            return (decimal)temp;
        }

        return null;
    }

}